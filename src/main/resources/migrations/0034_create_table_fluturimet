CREATE TABLE fluturimet (
    id_fluturimit INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    id_orarit INT UNSIGNED,
    id_kompanise INT UNSIGNED NOT NULL,
    id_linjes INT UNSIGNED NOT NULL,
    id_avionit INT UNSIGNED NOT NULL,
    numri_fluturimit VARCHAR(10) NOT NULL,
    data_fluturimit DATE NOT NULL,
    id_gejtit_nisjes INT UNSIGNED,
    ora_nisjes_planifikuar DATETIME NOT NULL,
    ora_nisjes_aktuale DATETIME,
    id_gejtit_mbrrritjes INT UNSIGNED,
    ora_mbrrritjes_planifikuar DATETIME NOT NULL,
    ora_mbrrritjes_aktuale DATETIME,
    statusi ENUM('i_planifikuar','boarding','ngritur','ne_fluturim','zbritur','mberriti','anuluar','i_vonuar','devijuar') NOT NULL DEFAULT 'i_planifikuar',
    shkaku_voneses VARCHAR(255),
    kapaciteti_total SMALLINT UNSIGNED NOT NULL,
    vendet_e_lira SMALLINT UNSIGNED NOT NULL,
    INDEX idx_data_fluturimit (data_fluturimit),
    INDEX idx_statusi (statusi),
    INDEX idx_numri (numri_fluturimit),
    CONSTRAINT fk_fluturimi_orari FOREIGN KEY (id_orarit) REFERENCES oraret(id_orarit),
    CONSTRAINT fk_fluturimi_kompania FOREIGN KEY (id_kompanise) REFERENCES kompanite_ajrore(id_kompanise),
    CONSTRAINT fk_fluturimi_linja FOREIGN KEY (id_linjes) REFERENCES linjat(id_linjes),
    CONSTRAINT fk_fluturimi_avioni FOREIGN KEY (id_avionit) REFERENCES avionet(id_avionit),
    CONSTRAINT fk_fluturimi_gejti_nisjes FOREIGN KEY (id_gejtit_nisjes) REFERENCES gejtat(id_gejtit),
    CONSTRAINT fk_fluturimi_gejti_mbrrritjes FOREIGN KEY (id_gejtit_mbrrritjes) REFERENCES gejtat(id_gejtit)
);
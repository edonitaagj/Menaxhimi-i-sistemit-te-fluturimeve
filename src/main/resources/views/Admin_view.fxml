<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.AdminController"
      prefWidth="1280" prefHeight="800"
      style="-fx-background-color: #F1F5F9;">

    <VBox prefWidth="260"
          style="-fx-background-color: linear-gradient(to bottom, #091E36, #030A12);
                 -fx-padding: 0;">

        <VBox style="-fx-padding: 28 24 24 24; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefWidth="40" prefHeight="40"
                           style="-fx-background-color: rgba(58,148,242,0.15);
                                  -fx-background-radius: 10;
                                  -fx-border-color: #3A94F2;
                                  -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label text="⚙" style="-fx-text-fill: #3A94F2; -fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="PRN ADMIN"
                           style="-fx-text-fill: white; -fx-font-size: 14;
                                  -fx-font-weight: 900; -fx-letter-spacing: 0.05em;"/>
                    <Label text="Paneli i Menaxhimit"
                           style="-fx-text-fill: rgba(133,183,235,0.45);
                                  -fx-font-size: 10; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox style="-fx-padding: 16 12 16 12;" spacing="4">

                <Label text="OPERACIONET"
                       style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10;
                              -fx-font-weight: 800; -fx-letter-spacing: 0.1em;
                              -fx-padding: 12 12 4 12;"/>

                <HBox fx:id="navDashboard" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-background-color: rgba(58,148,242,0.15);
                             -fx-border-color: #3A94F2; -fx-border-width: 0 0 0 3;
                             -fx-padding: 11 16 11 13; -fx-cursor: hand;">
                    <Label text="📊" style="-fx-font-size: 15;"/>
                    <Label text="Dashboard" style="-fx-text-fill: #3A94F2; -fx-font-size: 13; -fx-font-weight: 700;"/>
                </HBox>

                <HBox fx:id="navFluturimet" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="✈" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="Fluturimet &amp; Oraret" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <HBox fx:id="navRezervimet" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="🎫" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="Rezervimet &amp; Pagesat" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <Label text="LOGJISTIKA"
                       style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10;
                              -fx-font-weight: 800; -fx-letter-spacing: 0.1em;
                              -fx-padding: 20 12 4 12;"/>

                <HBox fx:id="navAvionet" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="🔧" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="Avionët &amp; Mirëmbajtja" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <HBox fx:id="navHumbur" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="🔍" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="Artikujt e Humbur" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="NEW" style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-size: 8; -fx-font-weight: 900; -fx-padding: 1 4 1 4; -fx-background-radius: 4;"/>
                </HBox>

                <Label text="ADMINISTRIMI"
                       style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10;
                              -fx-font-weight: 800; -fx-letter-spacing: 0.1em;
                              -fx-padding: 20 12 4 12;"/>

                <HBox fx:id="navStafi" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="👥" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="Menaxhimi i Stafit" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <HBox fx:id="navPasagjeret" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="👤" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="Pasagjerët" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <HBox fx:id="navKompanite" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="🏢" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="Kompanitë &amp; Linjat" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>
            </VBox>
        </ScrollPane>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox style="-fx-padding: 16 16 24 16; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1 0 0 0;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane prefWidth="36" prefHeight="36" style="-fx-background-color: #3A94F2; -fx-background-radius: 18;">
                    <Label text="AD" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="Administrator" style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: 700;"/>
                    <Label text="admin@prn-airport.com" style="-fx-text-fill: rgba(133,183,235,0.4); -fx-font-size: 10;"/>
                </VBox>
            </HBox>
            <Region prefHeight="15"/>
            <Button text="⟵  Dilni nga Sistemi" maxWidth="Infinity"
                    style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #F87171; -fx-font-size: 12; -fx-font-weight: 700; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: rgba(239,68,68,0.2); -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 16 32 16 32; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <VBox>
                <Label text="Sistemi i Menaxhimit të Aeroportit" style="-fx-text-fill: #94A3B8; -fx-font-size: 12; -fx-font-weight: 600;"/>
                <Label text="Paneli i Kontrollit" style="-fx-text-fill: #0F172A; -fx-font-size: 22; -fx-font-weight: 900;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="➕ Shto Fluturim" style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 8; -fx-padding: 8 16 8 16;"/>
                <StackPane prefWidth="40" prefHeight="40" style="-fx-background-color: #F1F5F9; -fx-background-radius: 20;">
                    <Label text="🔔" style="-fx-font-size: 16;"/>
                    <Circle radius="4" fill="#EF4444" StackPane.alignment="TOP_RIGHT">
                        <StackPane.margin><Insets top="8" right="8"/></StackPane.margin>
                    </Circle>
                </StackPane>
            </HBox>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: #F1F5F9; -fx-background-color: #F1F5F9; -fx-border-color: transparent;">
            <VBox style="-fx-padding: 32;" spacing="24">

                <HBox spacing="20">
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);">
                        <Label text="TOTALI FLUTURIMEVE" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;"/>
                        <Label text="142" style="-fx-text-fill: #0F172A; -fx-font-size: 28; -fx-font-weight: 900;"/>
                        <Label text="+12% nga muaji i kaluar" style="-fx-text-fill: #10B981; -fx-font-size: 11; -fx-font-weight: 700;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);">
                        <Label text="REDAKTIMET E STAFF-IT" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;"/>
                        <Label text="85" style="-fx-text-fill: #0F172A; -fx-font-size: 28; -fx-font-weight: 900;"/>
                        <Label text="10 aktivë tani" style="-fx-text-fill: #3A94F2; -fx-font-size: 11; -fx-font-weight: 700;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);">
                        <Label text="ARTIKUJT E HUMBUR" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;"/>
                        <Label text="12" style="-fx-text-fill: #EF4444; -fx-font-size: 28; -fx-font-weight: 900;"/>
                        <Label text="3 raportuar sot" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);">
                        <Label text="TË ARDHURAT (EUR)" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;"/>
                        <Label text="€ 24,500" style="-fx-text-fill: #0F172A; -fx-font-size: 28; -fx-font-weight: 900;"/>
                        <Label text="Sot, 2 Qershor" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;"/>
                    </VBox>
                </HBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 16;">

                    <HBox alignment="CENTER_LEFT" style="-fx-padding: 24; -fx-border-color: #F1F5F9; -fx-border-width: 0 0 1 0;">
                        <VBox spacing="4">
                            <Label text="Menaxhimi i Fluturimeve" style="-fx-text-fill: #0F172A; -fx-font-size: 18; -fx-font-weight: 900;"/>
                            <Label text="Modifiko statuset, nisjet dhe avionët në kohë reale" style="-fx-text-fill: #94A3B8; -fx-font-size: 12;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="10">
                            <TextField promptText="Kërko me kod ose destinacion..." style="-fx-background-radius: 8; -fx-min-width: 250; -fx-padding: 8;"/>
                            <Button text="Filter ▽" style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-font-weight: 700; -fx-background-radius: 8;"/>
                        </HBox>
                    </HBox>

                    <TableView fx:id="adminDataTable" prefHeight="400"
                               style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 10;">
                        <columns>
                            <TableColumn text="ID" prefWidth="50" />
                            <TableColumn text="KODI" prefWidth="100" />
                            <TableColumn text="KOMPANIA" prefWidth="150" />
                            <TableColumn text="DESTINACIONI" prefWidth="180" />
                            <TableColumn text="DATA/ORA" prefWidth="150" />
                            <TableColumn text="STATUSI" prefWidth="120" />
                            <TableColumn text="VEPRIMET" prefWidth="150" />
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" style="-fx-padding: 16 24 16 24; -fx-background-color: #F8FAFC; -fx-background-radius: 0 0 16 16;">
                        <HBox spacing="5" alignment="CENTER">
                            <Button text="Mëparshme" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 6;"/>
                            <Label text="Faqja 1 nga 10" style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-padding: 0 15 0 15;"/>
                            <Button text="Tjetra" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 6;"/>
                        </HBox>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
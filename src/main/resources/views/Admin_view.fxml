<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox prefHeight="800" prefWidth="1280" style="-fx-background-color: #F1F5F9;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="controllers.AdminController">

    <VBox prefWidth="260" style="-fx-background-color: linear-gradient(to bottom, #091E36, #030A12);                  -fx-padding: 0;">

        <VBox style="-fx-padding: 28 24 24 24; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="40" prefWidth="40" style="-fx-background-color: rgba(58,148,242,0.15);                                   -fx-background-radius: 10;                                   -fx-border-color: #3A94F2;                                   -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label style="-fx-text-fill: #3A94F2; -fx-font-size: 20;" text="⚙" />
                </StackPane>
                <VBox spacing="1">
                    <Label style="-fx-text-fill: white; -fx-font-size: 14;                                   -fx-font-weight: 900; -fx-letter-spacing: 0.05em;" text="PRN ADMIN" />
                    <Label style="-fx-text-fill: rgba(133,183,235,0.45);                                   -fx-font-size: 10; -fx-font-weight: 600;" text="Paneli i Menaxhimit" />
                </VBox>
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="4" style="-fx-padding: 16 12 16 12;">

                <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10;                               -fx-font-weight: 800; -fx-letter-spacing: 0.1em;                               -fx-padding: 12 12 4 12;" text="OPERACIONET" />

                <HBox fx:id="navDashboard" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(58,148,242,0.15);                              -fx-border-color: #3A94F2; -fx-border-width: 0 0 0 3;                              -fx-padding: 11 16 11 13; -fx-cursor: hand;">
                    <Label style="-fx-font-size: 15;" text="📊" />
                    <Label style="-fx-text-fill: #3A94F2; -fx-font-size: 13; -fx-font-weight: 700;" text="Dashboard" />
                </HBox>

                <HBox fx:id="navFluturimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="✈" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Fluturimet &amp; Oraret" />
                </HBox>

                <HBox fx:id="navRezervimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="🎫" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Rezervimet &amp; Pagesat" />
                </HBox>

                <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10;                               -fx-font-weight: 800; -fx-letter-spacing: 0.1em;                               -fx-padding: 20 12 4 12;" text="LOGJISTIKA" />

                <HBox fx:id="navAvionet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="🔧" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Avionët &amp; Mirëmbajtja" />
                </HBox>

                <HBox fx:id="navHumbur" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="🔍" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Artikujt e Humbur" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-size: 8; -fx-font-weight: 900; -fx-padding: 1 4 1 4; -fx-background-radius: 4;" text="NEW" />
                </HBox>

                <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10;                               -fx-font-weight: 800; -fx-letter-spacing: 0.1em;                               -fx-padding: 20 12 4 12;" text="ADMINISTRIMI" />

                <HBox fx:id="navStafi" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="👥" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Menaxhimi i Stafit" />
                </HBox>

                <HBox fx:id="navPasagjeret" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="👤" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Pasagjerët" />
                </HBox>

                <HBox fx:id="navKompanite" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="🏢" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Kompanitë &amp; Linjat" />
                </HBox>
            </VBox>
        </ScrollPane>

        <Region VBox.vgrow="ALWAYS" />

        <VBox style="-fx-padding: 16 16 24 16; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1 0 0 0;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane prefHeight="36" prefWidth="36" style="-fx-background-color: #3A94F2; -fx-background-radius: 18;">
                    <Label style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;" text="AD" />
                </StackPane>
                <VBox spacing="2">
                    <Label style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: 700;" text="Administrator" />
                    <Label style="-fx-text-fill: rgba(133,183,235,0.4); -fx-font-size: 10;" text="admin@prn-airport.com" />
                </VBox>
            </HBox>
            <Region prefHeight="15" />
            <Button maxWidth="Infinity" style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #F87171; -fx-font-size: 12; -fx-font-weight: 700; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: rgba(239,68,68,0.2); -fx-cursor: hand;" text="⟵  Dilni nga Sistemi" />
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 16 32 16 32; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <VBox>
                <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12; -fx-font-weight: 600;" text="Sistemi i Menaxhimit të Aeroportit" />
                <Label style="-fx-text-fill: #0F172A; -fx-font-size: 22; -fx-font-weight: 900;" text="Paneli i Kontrollit" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane prefHeight="40" prefWidth="40" style="-fx-background-color: #F1F5F9; -fx-background-radius: 20;">
                    <Label style="-fx-font-size: 16;" text="🔔" />
                    <Circle fill="#EF4444" radius="4" StackPane.alignment="TOP_RIGHT">
                        <StackPane.margin><Insets right="8" top="8" /></StackPane.margin>
                    </Circle>
                </StackPane>
            </HBox>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background: #F1F5F9; -fx-background-color: #F1F5F9; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <VBox spacing="24" style="-fx-padding: 32;">

                <HBox spacing="20">
                    <VBox style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;" text="TOTALI FLUTURIMEVE" />
                        <Label style="-fx-text-fill: #0F172A; -fx-font-size: 28; -fx-font-weight: 900;" text="142" />
                        <Label style="-fx-text-fill: #10B981; -fx-font-size: 11; -fx-font-weight: 700;" text="+12% nga muaji i kaluar" />
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;" text="REDAKTIMET E STAFF-IT" />
                        <Label style="-fx-text-fill: #0F172A; -fx-font-size: 28; -fx-font-weight: 900;" text="85" />
                        <Label style="-fx-text-fill: #3A94F2; -fx-font-size: 11; -fx-font-weight: 700;" text="10 aktivë tani" />
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;" text="ARTIKUJT E HUMBUR" />
                        <Label style="-fx-text-fill: #EF4444; -fx-font-size: 28; -fx-font-weight: 900;" text="12" />
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="3 raportuar sot" />
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;" text="TË ARDHURAT (EUR)" />
                        <Label style="-fx-text-fill: #0F172A; -fx-font-size: 28; -fx-font-weight: 900;" text="€ 24,500" />
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="Sot, 2 Qershor" />
                    </VBox>
                </HBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 16;">

                    <HBox alignment="CENTER_LEFT" style="-fx-padding: 24; -fx-border-color: #F1F5F9; -fx-border-width: 0 0 1 0;">
                        <VBox spacing="4">
                            <Label style="-fx-text-fill: #0F172A; -fx-font-size: 18; -fx-font-weight: 900;" text="Menaxhimi i Fluturimeve" />
                            <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12;" text="Modifiko statuset, nisjet dhe avionët në kohë reale" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="10">
                            <TextField promptText="Kërko me kod ose destinacion..." style="-fx-background-radius: 8; -fx-min-width: 250; -fx-padding: 8;" />
                            <Button style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-font-weight: 700; -fx-background-radius: 8;" text="Filter ▽" />
                        </HBox>
                    </HBox>

                    <TableView fx:id="adminDataTable" prefHeight="400" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 10;">
                        <columns>
                            <TableColumn prefWidth="50" text="ID" />
                            <TableColumn prefWidth="100" text="KODI" />
                            <TableColumn prefWidth="150" text="KOMPANIA" />
                            <TableColumn prefWidth="180" text="DESTINACIONI" />
                            <TableColumn prefWidth="150" text="DATA/ORA" />
                            <TableColumn prefWidth="120" text="STATUSI" />
                            <TableColumn prefWidth="150" text="VEPRIMET" />
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" style="-fx-padding: 16 24 16 24; -fx-background-color: #F8FAFC; -fx-background-radius: 0 0 16 16;">
                        <HBox alignment="CENTER" spacing="5">
                            <Button style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 6;" text="Mëparshme" />
                            <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-padding: 0 15 0 15;" text="Faqja 1 nga 10" />
                            <Button style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 6;" text="Tjetra" />
                        </HBox>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>

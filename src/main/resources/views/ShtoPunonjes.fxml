<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="640" prefWidth="520" spacing="0" style="-fx-background-color: #F1F5F9;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="controllers.ShtoPunonjesController">

    <VBox style="-fx-background-color: white; -fx-padding: 24 32 20 32; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800; -fx-letter-spacing: 0.05em;" text="%emp.add.title.category" />
        <Label style="-fx-text-fill: #0F172A; -fx-font-size: 20; -fx-font-weight: 900;" text="%emp.add.title.main" />
    </VBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F1F5F9; -fx-border-color: transparent;" vbarPolicy="ALWAYS" VBox.vgrow="ALWAYS">
        <VBox spacing="18" style="-fx-padding: 32; -fx-background-color: #F1F5F9;">

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="%emp.add.label.firstname" />
                    <TextField fx:id="txtEmri" promptText="%emp.add.placeholder.firstname" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="%emp.add.label.lastname" />
                    <TextField fx:id="txtMbiemri" promptText="%emp.add.placeholder.lastname" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
                </VBox>
            </HBox>

            <VBox spacing="6">
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="%emp.add.label.email" />
                <TextField fx:id="txtEmail" promptText="%emp.add.placeholder.email" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
            </VBox>

            <VBox spacing="6">
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="%emp.add.label.phone" />
                <TextField fx:id="txtTelefoni" promptText="%emp.add.placeholder.phone" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
            </VBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="%emp.add.label.department" />
                    <ComboBox fx:id="cmbDepartamenti" maxWidth="Infinity" promptText="%emp.add.placeholder.department" style="-fx-background-radius: 6; -fx-padding: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="%emp.add.label.role" />
                    <TextField fx:id="txtRoli" promptText="%emp.add.placeholder.role" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
                </VBox>
            </HBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="%emp.add.label.hiredate" />
                    <DatePicker fx:id="dtPunesimit" maxWidth="Infinity" style="-fx-background-radius: 6; -fx-padding: 4; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="%emp.add.label.salary" />
                    <TextField fx:id="txtPaga" promptText="%emp.add.placeholder.salary" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
                </VBox>
            </HBox>

        </VBox>
    </ScrollPane>

    <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-background-color: white; -fx-padding: 16 32 16 32; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
        <Button onAction="#handleAnulo" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-weight: 700; -fx-padding: 10 20; -fx-cursor: hand;" text="%emp.add.action.cancel" />
        <Button onAction="#handleRuajPunonjes" style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 10 24; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(58,148,242,0.2), 8, 0, 0, 3);" text="%emp.add.action.save" />
    </HBox>

</VBox>
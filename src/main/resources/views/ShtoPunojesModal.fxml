<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="640" prefWidth="520" spacing="0" style="-fx-background-color: #F1F5F9;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="controllers.ShtoPunonjesController">

    <VBox style="-fx-background-color: white; -fx-padding: 24 32 20 32; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800; -fx-letter-spacing: 0.05em;" text="KRIJO PROFILIN E RI" />
        <Label style="-fx-text-fill: #0F172A; -fx-font-size: 20; -fx-font-weight: 900;" text="Regjistrimi i një Punonjësi në Sistem" />
    </VBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F1F5F9; -fx-border-color: transparent;" vbarPolicy="ALWAYS" VBox.vgrow="ALWAYS">
        <VBox spacing="18" style="-fx-padding: 32; -fx-background-color: #F1F5F9;">

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Emri *" />
                    <TextField fx:id="txtEmri" promptText="p.sh. Arben" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Mbiemri *" />
                    <TextField fx:id="txtMbiemri" promptText="p.sh. Gashi" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
                </VBox>
            </HBox>

            <VBox spacing="6">
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Adresa Elektronike (E-mail) *" />
                <TextField fx:id="txtEmail" promptText="arben.gashi@airport-prn.com" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
            </VBox>

            <VBox spacing="6">
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Numri i Telefonit" />
                <TextField fx:id="txtTelefoni" promptText="+383 4X XXX XXX" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
            </VBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Departamenti *" />
                    <ComboBox fx:id="cmbDepartamenti" maxWidth="Infinity" promptText="Zgjidh Sektorin..." style="-fx-background-radius: 6; -fx-padding: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Roli / Pozita *" />
                    <TextField fx:id="txtRoli" promptText="p.sh. Inxhinier Avionësh" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
                </VBox>
            </HBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Data e Punësimit" />
                    <DatePicker fx:id="dtPunesimit" maxWidth="Infinity" style="-fx-background-radius: 6; -fx-padding: 4; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Paga Neto (€) *" />
                    <TextField fx:id="txtPaga" promptText="0.00" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-color: white;" />
                </VBox>
            </HBox>

        </VBox>
    </ScrollPane>

    <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-background-color: white; -fx-padding: 16 32 16 32; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
        <Button onAction="#handleAnulo" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-weight: 700; -fx-padding: 10 20; -fx-cursor: hand;" text="Anulo" />
        <Button onAction="#handleRuajPunonjes" style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 10 24; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(58,148,242,0.2), 8, 0, 0, 3);" text="💾 Ruaj Punonjësin" />
    </HBox>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.SignupController"
      prefWidth="860" prefHeight="600"
      style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 10);">

    <StackPane prefWidth="410"
               style="-fx-background-color: linear-gradient(to bottom right, #091E36, #030A12); -fx-background-radius: 16 0 0 16;">

        <VBox alignment="TOP_LEFT" spacing="0"
              style="-fx-padding: 40 32 32 32;">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefWidth="42" prefHeight="42"
                           style="-fx-background-color: rgba(55, 138, 221, 0.12);
                                  -fx-background-radius: 10;
                                  -fx-border-color: rgba(55, 138, 221, 0.3);
                                  -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label text="%signUp.text.symbol" style="-fx-text-fill: #3A94F2; -fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="%signUp.text.aeroporti.adem.jashari"
                           style="-fx-text-fill: white; -fx-font-size: 12;
                                  -fx-font-weight: 900; -fx-letter-spacing: 0.05em; -fx-font-family: 'System';"/>
                    <Label text="%signUp.text.prn.pristina.international"
                           style="-fx-text-fill: rgba(133, 183, 235, 0.4);
                                  -fx-font-size: 11; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="%signUp.text.prn"
                   style="-fx-text-fill: linear-gradient(to bottom, rgba(255,255,255,0.05), rgba(255,255,255,0.002));
                          -fx-font-size: 110; -fx-font-weight: 900;
                          -fx-font-family: 'System';"
                   alignment="CENTER"
                   maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="0"
                  style="-fx-background-color: rgba(255, 255, 255, 0.03);
                         -fx-border-color: rgba(255, 255, 255, 0.08);
                         -fx-border-width: 1; -fx-border-radius: 12;
                         -fx-background-radius: 12; -fx-padding: 16;">

                <HBox alignment="CENTER_LEFT">
                    <Label text="%signUp.text.fluturimet.live"
                           style="-fx-text-fill: rgba(255, 255, 255, 0.6);
                                  -fx-font-size: 11; -fx-font-weight: 800;
                                  -fx-letter-spacing: 0.08em;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER" spacing="5"
                          style="-fx-background-color: rgba(16, 185, 129, 0.15); -fx-padding: 3 8 3 8; -fx-background-radius: 20;">
                        <Circle radius="3.5" fill="#10B981"/>
                        <Label text="%signUp.text.online"
                               style="-fx-text-fill: #10B981; -fx-font-size: 9;
                                      -fx-font-weight: 900; -fx-letter-spacing: 0.05em;"/>
                    </HBox>
                </HBox>

                <Region prefHeight="14"/>

                <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-padding: 8 0 8 0; -fx-border-color: rgba(255,255,255,0.05); -fx-border-width: 0 0 1 0;">
                    <Label text="%signUp.text.bt.241" prefWidth="60" style="-fx-text-fill: #85B7EB; -fx-font-size: 12; -fx-font-weight: 700;"/>
                    <Label text="%signUp.text.prn" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;"/>
                    <Label text="%signUp.text.symbol.2" style="-fx-text-fill: rgba(255,255,255,0.2); -fx-font-size: 12;"/>
                    <Label text="%signUp.text.vie" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="%signUp.text.boarding"
                           style="-fx-text-fill: #3A94F2;
                                  -fx-background-color: rgba(58, 148, 242, 0.12);
                                  -fx-border-color: rgba(58, 148, 242, 0.25);
                                  -fx-border-width: 1; -fx-border-radius: 6;
                                  -fx-background-radius: 6; -fx-padding: 4 8 4 8;
                                  -fx-font-size: 9; -fx-font-weight: 800;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-padding: 8 0 8 0; -fx-border-color: rgba(255,255,255,0.05); -fx-border-width: 0 0 1 0;">
                    <Label text="%signUp.text.w6.301" prefWidth="60" style="-fx-text-fill: #85B7EB; -fx-font-size: 12; -fx-font-weight: 700;"/>
                    <Label text="%signUp.text.prn" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;"/>
                    <Label text="%signUp.text.symbol.2" style="-fx-text-fill: rgba(255,255,255,0.2); -fx-font-size: 12;"/>
                    <Label text="%signUp.text.lgw" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="%signUp.text.ne.kohe"
                           style="-fx-text-fill: #10B981;
                                  -fx-background-color: rgba(16, 185, 129, 0.12);
                                  -fx-border-color: rgba(16, 185, 129, 0.25);
                                  -fx-border-width: 1; -fx-border-radius: 6;
                                  -fx-background-radius: 6; -fx-padding: 4 8 4 8;
                                  -fx-font-size: 9; -fx-font-weight: 800;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-padding: 8 0 0 0;">
                    <Label text="%signUp.text.tk.412" prefWidth="60" style="-fx-text-fill: #85B7EB; -fx-font-size: 12; -fx-font-weight: 700;"/>
                    <Label text="%signUp.text.prn" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;"/>
                    <Label text="%signUp.text.symbol.2" style="-fx-text-fill: rgba(255,255,255,0.2); -fx-font-size: 12;"/>
                    <Label text="%signUp.text.ist" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="%signUp.text.vonuar"
                           style="-fx-text-fill: #F59E0B;
                                  -fx-background-color: rgba(245, 158, 11, 0.12);
                                  -fx-border-color: rgba(245, 158, 11, 0.25);
                                  -fx-border-width: 1; -fx-border-radius: 6;
                                  -fx-background-radius: 6; -fx-padding: 4 8 4 8;
                                  -fx-font-size: 9; -fx-font-weight: 800;"/>
                </HBox>
            </VBox>
        </VBox>
    </StackPane>

    <!-- RIGHT PANEL -->
    <VBox prefWidth="450" alignment="CENTER_LEFT"
          style="-fx-background-color: white;
                 -fx-background-radius: 0 16 16 0;
                 -fx-padding: 42 50 42 50;"
          spacing="0">

        <Label text="%signUp.text.krijo.llogari"
               style="-fx-text-fill: #0F172A; -fx-font-size: 30;
                      -fx-font-weight: 900; -fx-font-family: 'System'"/>
        <Region prefHeight="4"/>

        <Region prefHeight="24"/>

        <!-- Error Box -->
        <HBox fx:id="errBox" alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #FEF2F2;
                     -fx-border-color: #FCA5A5; -fx-border-width: 1;
                     -fx-border-radius: 10; -fx-background-radius: 10;
                     -fx-padding: 12 16 12 16;"
              visible="false" managed="false">
            <Label text="%signUp.text.symbol.3" style="-fx-text-fill: #DC2626; -fx-font-size: 14;"/>
            <Label fx:id="errLabel"
                   text="%signUp.text.ndodhi.nje.gabim.gjate.regjistrimit"
                   style="-fx-text-fill: #DC2626; -fx-font-size: 13; -fx-font-weight: 700;"/>
        </HBox>
        <Region fx:id="errSpacer" prefHeight="16" visible="false" managed="false"/>

        <!-- Emri + Mbiemri (side by side) -->
        <HBox spacing="12" maxWidth="Infinity">
            <VBox HBox.hgrow="ALWAYS" spacing="0">
                <Label text="%signUp.text.emri"
                       style="-fx-text-fill: #475569; -fx-font-size: 11;
                              -fx-font-weight: 800; -fx-letter-spacing: 0.06em;"/>
                <Region prefHeight="8"/>
                <StackPane alignment="CENTER_RIGHT" maxWidth="Infinity">
                    <TextField fx:id="emriField"
                               promptText="%signUp.promptText.emri"
                               style="-fx-background-color: #F8FAFC;
                                      -fx-border-color: #E2E8F0; -fx-border-width: 1.5;
                                      -fx-border-radius: 10; -fx-background-radius: 10;
                                      -fx-padding: 14 45 14 16;
                                      -fx-font-size: 14; -fx-text-fill: #0F172A;
                                      -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 800;"
                               maxWidth="Infinity"/>
                    <Label text="%signUp.text.symbol.4" style="-fx-text-fill: #94A3B8; -fx-font-size: 16; -fx-padding: 0 14 0 0;"/>
                </StackPane>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="0">
                <Label text="%signUp.text.mbiemri"
                       style="-fx-text-fill: #475569; -fx-font-size: 11;
                              -fx-font-weight: 800; -fx-letter-spacing: 0.06em;"/>
                <Region prefHeight="8"/>
                <StackPane alignment="CENTER_RIGHT" maxWidth="Infinity">
                    <TextField fx:id="mbiemriField"
                               promptText="%signUp.promptText.mbiemri"
                               style="-fx-background-color: #F8FAFC;
                                      -fx-border-color: #E2E8F0; -fx-border-width: 1.5;
                                      -fx-border-radius: 10; -fx-background-radius: 10;
                                      -fx-padding: 14 45 14 16;
                                      -fx-font-size: 14; -fx-text-fill: #0F172A;
                                      -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 800;"
                               maxWidth="Infinity"/>
                    <Label text="%signUp.text.symbol.4" style="-fx-text-fill: #94A3B8; -fx-font-size: 16; -fx-padding: 0 14 0 0;"/>
                </StackPane>
            </VBox>
        </HBox>

        <Region prefHeight="18"/>

        <!-- Username -->
        <Label text="%signUp.text.username"
               style="-fx-text-fill: #475569; -fx-font-size: 11;
                      -fx-font-weight: 800; -fx-letter-spacing: 0.06em;"/>
        <Region prefHeight="8"/>
        <StackPane alignment="CENTER_RIGHT" maxWidth="Infinity">
            <TextField fx:id="usernameField"
                       promptText="%signUp.promptText.username"
                       style="-fx-background-color: #F8FAFC;
                              -fx-border-color: #E2E8F0; -fx-border-width: 1.5;
                              -fx-border-radius: 10; -fx-background-radius: 10;
                              -fx-padding: 14 45 14 16;
                              -fx-font-size: 14; -fx-text-fill: #0F172A;
                              -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 800;"
                       maxWidth="Infinity"/>
            <Label text="%signUp.text.symbol.5" style="-fx-text-fill: #94A3B8; -fx-font-size: 16; -fx-padding: 0 16 0 0;"/>
        </StackPane>

        <Region prefHeight="18"/>

        <!-- Email -->
        <Label text="%signUp.text.email"
               style="-fx-text-fill: #475569; -fx-font-size: 11;
                      -fx-font-weight: 800; -fx-letter-spacing: 0.06em;"/>
        <Region prefHeight="8"/>
        <StackPane alignment="CENTER_RIGHT" maxWidth="Infinity">
            <TextField fx:id="emailField"
                       promptText="%signUp.promptText.emri.shembull.com"
                       style="-fx-background-color: #F8FAFC;
                              -fx-border-color: #E2E8F0; -fx-border-width: 1.5;
                              -fx-border-radius: 10; -fx-background-radius: 10;
                              -fx-padding: 14 45 14 16;
                              -fx-font-size: 14; -fx-text-fill: #0F172A;
                              -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 800;"
                       maxWidth="Infinity"/>
            <Label text="%signUp.text.symbol.6" style="-fx-text-fill: #94A3B8; -fx-font-size: 16; -fx-padding: 0 16 0 0;"/>
        </StackPane>

        <Region prefHeight="18"/>

        <!-- Password -->
        <Label text="%signUp.text.fjalekalimi"
               style="-fx-text-fill: #475569; -fx-font-size: 11;
                      -fx-font-weight: 800; -fx-letter-spacing: 0.06em;"/>
        <Region prefHeight="8"/>
        <StackPane alignment="CENTER_RIGHT" maxWidth="Infinity">
            <PasswordField fx:id="passField"
                           promptText="%signUp.promptText.symbol"
                           style="-fx-background-color: #F8FAFC;
                                  -fx-border-color: #E2E8F0; -fx-border-width: 1.5;
                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                  -fx-padding: 14 45 14 16;
                                  -fx-font-size: 14; -fx-text-fill: #0F172A;
                                  -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 800;"
                           maxWidth="Infinity"/>
            <Label text="%signUp.text.symbol.7" style="-fx-text-fill: #94A3B8; -fx-font-size: 16; -fx-padding: 0 16 0 0;"/>
        </StackPane>

        <Region prefHeight="18"/>

        <!-- Confirm Password -->
        <Label text="%signUp.text.konfirmo.fjalekalimin"
               style="-fx-text-fill: #475569; -fx-font-size: 11;
                      -fx-font-weight: 800; -fx-letter-spacing: 0.06em;"/>
        <Region prefHeight="8"/>
        <StackPane alignment="CENTER_RIGHT" maxWidth="Infinity">
            <PasswordField fx:id="confirmPassField"
                           promptText="%signUp.promptText.symbol"
                           style="-fx-background-color: #F8FAFC;
                                  -fx-border-color: #E2E8F0; -fx-border-width: 1.5;
                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                  -fx-padding: 14 45 14 16;
                                  -fx-font-size: 14; -fx-text-fill: #0F172A;
                                  -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 800;"
                           maxWidth="Infinity"/>
            <Label text="%signUp.text.symbol.8" style="-fx-text-fill: #94A3B8; -fx-font-size: 16; -fx-padding: 0 16 0 0;"/>
        </StackPane>

        <Region prefHeight="8"/>

        <!-- Password hint -->
        <HBox alignment="CENTER_LEFT" spacing="6">
            <Label text="%signUp.text.i"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 11;"/>
            <Label text="%signUp.text.minimumi.8.karaktere.te.pakten.1.numer"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 500;"/>
        </HBox>

        <Region prefHeight="28"/>

        <!-- Register Button -->
        <Button fx:id="signupBtn"
                text="%signUp.text.krijo.llogarine"
                onAction="#handleSignUp"
                maxWidth="Infinity"
                style="-fx-background-color: linear-gradient(to right, #091E36, #122D4F);
                       -fx-text-fill: white;
                       -fx-font-size: 15; -fx-font-weight: 800;
                       -fx-background-radius: 10;
                       -fx-cursor: hand; -fx-padding: 14 0 14 0;
                       -fx-letter-spacing: 0.02em;
                       -fx-effect: dropshadow(three-pass-box, rgba(9,30,54,0.2), 10, 0, 0, 4);"/>

        <Region prefHeight="12"/>

        <!-- Back to Login Button -->
        <Button fx:id="loginBtn"
                text="%signUp.text.keni.tashme.llogari.hyni.ketu"
                onAction="#handleBackToLogin"
                maxWidth="Infinity"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #334155;
                       -fx-font-size: 14; -fx-font-weight: 700;
                       -fx-border-color: #CBD5E1; -fx-border-width: 1.5;
                       -fx-border-radius: 10; -fx-background-radius: 10;
                       -fx-cursor: hand; -fx-padding: 13 0 13 0;"/>

    </VBox>
</HBox>
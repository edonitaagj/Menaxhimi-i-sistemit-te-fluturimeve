<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="480" spacing="22" style="-fx-background-color: white; -fx-padding: 28;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PagesaModalController">

    <VBox spacing="4">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label style="-fx-font-size: 18;" text="💳" />
            <Label style="-fx-text-fill: #0F172A; -fx-font-size: 18; -fx-font-weight: 900;" text="%payment.modal.title" />
        </HBox>
        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12; -fx-font-weight: 600;" text="%payment.modal.subtitle" />
        <Separator style="-fx-padding: 6 0 0 0;" />
    </VBox>

    <HBox style="-fx-background-color: #F8FAFC; -fx-padding: 14; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 8;">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="%payment.modal.bookingCode" />
            <Label fx:id="lblKodiRezervimit" style="-fx-text-fill: #0F172A; -fx-font-size: 14; -fx-font-weight: 800;" text="PRNOS011" />
        </VBox>
        <VBox alignment="TOP_RIGHT" spacing="4">
            <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="%payment.modal.amountToPay" />
            <HBox alignment="CENTER_RIGHT" spacing="4">
                <Label fx:id="lblShuma" style="-fx-text-fill: #10B981; -fx-font-size: 18; -fx-font-weight: 900;" text="189.00" />
                <Label fx:id="lblMonedha" style="-fx-text-fill: #10B981; -fx-font-size: 14; -fx-font-weight: 700;" text="EUR" />
            </HBox>
        </VBox>
    </HBox>

    <VBox spacing="14">

        <VBox spacing="6">
            <Label style="-fx-text-fill: #475569; -fx-font-size: 12; -fx-font-weight: 700;" text="%payment.form.method" />
            <ComboBox fx:id="cmbMetodaPageses" maxWidth="Infinity" onAction="#handleMetodaChange" promptText="%payment.form.method.placeholder" style="-fx-background-radius: 6; -fx-padding: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6;">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="karte" />
                        <String fx:value="online" />
                        <String fx:value="cash" />
                        <String fx:value="transfer" />
                        <String fx:value="voucher" />
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>

        <VBox fx:id="vboxDetajetKartes" spacing="12" style="-fx-padding: 6 0 0 0;">
            <VBox spacing="6">
                <Label style="-fx-text-fill: #475569; -fx-font-size: 12; -fx-font-weight: 700;" text="%payment.form.cardDetails" />
                <TextField fx:id="txtDetajetPageses" promptText="%payment.form.cardDetails.placeholder" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6;" />
            </VBox>

            <HBox spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label style="-fx-text-fill: #475569; -fx-font-size: 12; -fx-font-weight: 700;" text="%payment.form.expiry" />
                    <TextField promptText="%payment.form.expiry.placeholder" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6;" />
                </VBox>
                <VBox prefWidth="120" spacing="6">
                    <Label style="-fx-text-fill: #475569; -fx-font-size: 12; -fx-font-weight: 700;" text="%payment.form.cvv" />
                    <PasswordField promptText="%payment.form.cvv.placeholder" style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 6;" />
                </VBox>
            </HBox>
        </VBox>

        <VBox spacing="6">
            <Label style="-fx-text-fill: #475569; -fx-font-size: 12; -fx-font-weight: 700;" text="%payment.form.notes" />
            <TextArea fx:id="txtShenimetPageses" prefHeight="55" promptText="%payment.form.notes.placeholder" style="-fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-font-size: 12;" wrapText="true" />
        </VBox>

    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 6 0 0 0;">
        <Button onAction="#handleAnuloPagesen" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-weight: 700; -fx-cursor: hand; -fx-padding: 10 16;" text="%payment.button.later" />

        <Button onAction="#handleKryejPagesen" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 6; -fx-padding: 11 24; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(16,185,129,0.2), 6, 0, 0, 2);" text="%payment.button.authorize" />
    </HBox>

</VBox>
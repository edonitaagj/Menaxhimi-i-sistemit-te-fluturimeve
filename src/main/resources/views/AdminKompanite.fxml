                            <Button fx:id="btnDeleteKompania" disable="true" onAction="#handleDeleteKompania" style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #EF4444; -fx-font-weight: 700; -fx-background-radius: 6; -fx-padding: 8 12; -fx-cursor: hand;" text="%adminKompanite.text.fshij" />

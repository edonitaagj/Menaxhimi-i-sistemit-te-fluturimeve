<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.AdminFluturimetController"
      prefWidth="1280" prefHeight="800"
      style="-fx-background-color: #F1F5F9;">

    <VBox prefWidth="260" style="-fx-background-color: linear-gradient(to bottom, #091E36, #030A12);">
        <VBox style="-fx-padding: 28 24 24 24; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefWidth="40" prefHeight="40" style="-fx-background-color: rgba(58,148,242,0.15); -fx-background-radius: 10; -fx-border-color: #3A94F2; -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label text="⚙" style="-fx-text-fill: #3A94F2; -fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="%sidebar.title" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: 900; -fx-letter-spacing: 0.05em;"/>
                    <Label text="%sidebar.subtitle" style="-fx-text-fill: rgba(133,183,235,0.45); -fx-font-size: 10; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox style="-fx-padding: 16 12 16 12;" spacing="4">
                <Label text="%sidebar.category.operations" style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 12 12 4 12;"/>

                <HBox fx:id="navDashboard" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="📊" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%menu.dashboard" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <HBox fx:id="navFluturimet" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(58,148,242,0.15); -fx-border-color: #3A94F2; -fx-border-width: 0 0 0 3; -fx-padding: 11 16 11 13; -fx-cursor: hand;">
                    <Label text="✈" style="-fx-font-size: 15;"/>
                    <Label text="%menu.flights" style="-fx-text-fill: #3A94F2; -fx-font-size: 13; -fx-font-weight: 700;"/>
                </HBox>

                <HBox fx:id="navRezervimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="🎫" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%menu.bookings" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <Label text="%sidebar.category.logistics" style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 20 12 4 12;"/>
                <HBox fx:id="navAvionet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="🔧" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%menu.planes" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <HBox fx:id="navHumbur" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="🔍" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%menu.lostfound" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <Label text="%sidebar.category.administration" style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 20 12 4 12;"/>
                <HBox fx:id="navStafi" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="👥" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%menu.staff" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>
            </VBox>
        </ScrollPane>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox style="-fx-padding: 16 16 24 16; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1 0 0 0;">
            <Button onAction="#handleLogout" text="%button.logout" maxWidth="Infinity" style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #F87171; -fx-font-size: 12; -fx-font-weight: 700; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: rgba(239,68,68,0.2); -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 16 32 16 32; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <VBox>
                <Label text="%flights.header.systemName" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;"/>
                <Label text="%flights.header.pageTitle" style="-fx-text-fill: #0F172A; -fx-font-size: 22; -fx-font-weight: 900;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="12">
                <TextField fx:id="adminSearchField" onKeyReleased="#handleAdminSearch" promptText="%flights.search.placeholder" style="-fx-background-radius: 8; -fx-padding: 8 16; -fx-min-width: 250; -fx-border-color: #E2E8F0;"/>
            </HBox>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: #F1F5F9; -fx-background-color: #F1F5F9; -fx-border-color: transparent;">
            <VBox style="-fx-padding: 32;" spacing="24">

                <VBox style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 15, 0, 0, 5); -fx-border-color: #E2E8F0; -fx-border-radius: 16;">
                    <Label text="%flights.form.title" style="-fx-text-fill: #0F172A; -fx-font-size: 14; -fx-font-weight: 800; -fx-padding: 0 0 15 0;"/>
                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                        </columnConstraints>
                        <children>
                            <VBox spacing="6" GridPane.columnIndex="0">
                                <Label text="%flights.form.flightCode" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;"/>
                                <TextField fx:id="txtKodi" promptText="%flights.form.flightCode.placeholder" style="-fx-background-radius: 6; -fx-padding: 8;"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="1">
                                <Label text="%flights.form.airline" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;"/>
                                <ComboBox fx:id="cmbKompania" promptText="%flights.form.select.placeholder" maxWidth="Infinity" style="-fx-background-radius: 6; -fx-padding: 4;"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="2">
                                <Label text="%flights.form.origin" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;"/>
                                <TextField fx:id="txtOrigjina" promptText="%flights.form.origin.placeholder" style="-fx-background-radius: 6; -fx-padding: 8;"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="3">
                                <Label text="%flights.form.destination" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;"/>
                                <TextField fx:id="txtDestinacioni" promptText="%flights.form.destination.placeholder" style="-fx-background-radius: 6; -fx-padding: 8;"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="4">
                                <Label text="%flights.form.initialStatus" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;"/>
                                <ComboBox fx:id="cmbStatusi" promptText="%flights.form.select.placeholder" maxWidth="Infinity" style="-fx-background-radius: 6; -fx-padding: 4;"/>
                            </VBox>
                        </children>
                    </GridPane>
                    <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 20 0 0 0;">
                        <Button onAction="#handleClearForm" text="%flights.button.clear" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-weight: 700; -fx-cursor: hand;"/>
                        <Button onAction="#handleSaveFluturim" text="%flights.button.register" style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.01), 10, 0, 0, 5);">
                    <TableView fx:id="tblFluturimet" prefHeight="450" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 10;">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn text="%flights.column.id" prefWidth="60" fx:id="colId"/>
                            <TableColumn text="%flights.column.code" prefWidth="100" fx:id="colKodi"/>
                            <TableColumn text="%flights.column.company" prefWidth="180" fx:id="colKompania"/>
                            <TableColumn text="%flights.column.origin" prefWidth="140" fx:id="colOrigjina"/>
                            <TableColumn text="%flights.column.destination" prefWidth="140" fx:id="colDestinacioni"/>
                            <TableColumn text="%flights.column.gate" prefWidth="100" fx:id="colGate"/>
                            <TableColumn text="%flights.column.status" prefWidth="130" fx:id="colStatusi"/>
                            <TableColumn text="%flights.column.actions" prefWidth="140" fx:id="colVeprimet"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
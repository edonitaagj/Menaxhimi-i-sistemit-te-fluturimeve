<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.AdminStafiController"
      prefWidth="1280" prefHeight="800"
      style="-fx-background-color: #F1F5F9;">

    <VBox prefWidth="260" style="-fx-background-color: linear-gradient(to bottom, #091E36, #030A12);">
        <VBox style="-fx-padding: 28 24 24 24; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefWidth="40" prefHeight="40" style="-fx-background-color: rgba(58,148,242,0.15); -fx-background-radius: 10; -fx-border-color: #3A94F2; -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label text="%adminStafi.text.symbol" style="-fx-text-fill: #3A94F2; -fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="%adminStafi.text.prn.admin" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: 900; -fx-letter-spacing: 0.05em;"/>
                    <Label text="%adminStafi.text.paneli.i.menaxhimit" style="-fx-text-fill: rgba(133,183,235,0.45); -fx-font-size: 10; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox style="-fx-padding: 16 12 16 12;" spacing="4">
                <Label text="%adminStafi.text.operacionet" style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 12 12 4 12;"/>

                <HBox fx:id="navDashboard" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="%adminStafi.text.symbol.2" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%adminStafi.text.dashboard" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <HBox fx:id="navFluturimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="%adminStafi.text.symbol.3" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%adminStafi.text.fluturimet.and.oraret" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <HBox fx:id="navRezervimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="%adminStafi.text.symbol.4" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%adminStafi.text.rezervimet.and.pagesat" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <Label text="%adminStafi.text.logjistika" style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 20 12 4 12;"/>
                <HBox fx:id="navAvionet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="%adminStafi.text.symbol.5" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%adminStafi.text.avionet.and.mirembajtja" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <HBox fx:id="navHumbur" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="%adminStafi.text.symbol.6" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%adminStafi.text.artikujt.e.humbur" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <Label text="%adminStafi.text.administrimi" style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 20 12 4 12;"/>

                <HBox fx:id="navStafi" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(58,148,242,0.15); -fx-border-color: #3A94F2; -fx-border-width: 0 0 0 3; -fx-padding: 11 16 11 13; -fx-cursor: hand;">
                    <Label text="%adminStafi.text.symbol.7" style="-fx-font-size: 15;"/>
                    <Label text="%adminStafi.text.menaxhimi.i.stafit" style="-fx-text-fill: #3A94F2; -fx-font-size: 13; -fx-font-weight: 700;"/>
                </HBox>
                <HBox fx:id="navPasagjeret" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%adminStafi.text.symbol.8" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="%adminStafi.text.pasagjeret" />
                </HBox>

                <HBox fx:id="navKompanite" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%adminStafi.text.symbol.9" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="%adminStafi.text.kompanite.and.linjat" />
                </HBox>
            </VBox>
        </ScrollPane>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox style="-fx-padding: 16 16 24 16; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1 0 0 0;">
            <Button onAction="#handleLogout" text="%adminStafi.text.dilni.nga.sistemi" maxWidth="Infinity" style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #F87171; -fx-font-size: 12; -fx-font-weight: 700; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: rgba(239,68,68,0.2); -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 16 32 16 32; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <VBox>
                <Label text="%adminStafi.text.burimet.njerezore" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;"/>
                <Label text="%adminStafi.text.regjistri.i.stafit.and.departamentet" style="-fx-text-fill: #0F172A; -fx-font-size: 22; -fx-font-weight: 900;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10">
                <Button onAction="#handleAddNewStaffModal" text="%adminStafi.text.shto.punonjes.te.ri" style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
            </HBox>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: #F1F5F9; -fx-background-color: #F1F5F9; -fx-border-color: transparent;">
            <VBox style="-fx-padding: 32;" spacing="24">

                <HBox spacing="20">
                    <!-- KARTA 1: TOTALI I STAFIT -->
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);">
                        <Label text="%adminStafi.text.totali.i.stafit" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;"/>
                        <Label fx:id="lblTotaliStafit" text="%adminStafi.text.0.punonjes" style="-fx-text-fill: #0F172A; -fx-font-size: 22; -fx-font-weight: 900; -fx-padding: 5 0 0 0;"/>
                    </VBox>

                    <!-- KARTA 2: STAFI AKTIV -->
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);">
                        <Label text="%adminStafi.text.stafi.aktiv" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;"/>
                        <Label fx:id="lblStafiAktiv" text="%adminStafi.text.0.aktive" style="-fx-text-fill: #10B981; -fx-font-size: 22; -fx-font-weight: 900; -fx-padding: 5 0 0 0;"/>
                    </VBox>

                    <!-- KARTA 3: DEPARTAMENTE -->
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);">
                        <Label text="%adminStafi.text.departamente" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;"/>
                        <Label fx:id="lblDepartamente" text="%adminStafi.text.0.sektore" style="-fx-text-fill: #3A94F2; -fx-font-size: 22; -fx-font-weight: 900; -fx-padding: 5 0 0 0;"/>
                    </VBox>
                </HBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.01), 10, 0, 0, 5);">
                    <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 24 10 24;">
                        <Label text="%adminStafi.text.lista.e.punonjesve" style="-fx-text-fill: #0F172A; -fx-font-size: 16; -fx-font-weight: 800;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="txtSearchStaf" promptText="%adminStafi.promptText.kerko.me.emer.rol" style="-fx-background-radius: 6; -fx-padding: 6 12;"/>
                            <ComboBox fx:id="cmbDepartamentiFilter" promptText="%adminStafi.promptText.departamenti" style="-fx-background-radius: 6;"/>
                        </HBox>
                    </HBox>

                    <TableView fx:id="tblStafi" prefHeight="450" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 10;">
                        <columns>
                            <TableColumn text="%adminStafi.text.id" prefWidth="60" fx:id="colStafiId"/>
                            <TableColumn text="%adminStafi.text.emri" prefWidth="140" fx:id="colEmri"/>
                            <TableColumn text="%adminStafi.text.mbiemri" prefWidth="140" fx:id="colMbiemri"/>
                            <TableColumn text="%adminStafi.text.roli.pozita" prefWidth="180" fx:id="colRoli"/>
                            <TableColumn text="%adminStafi.text.departamenti" prefWidth="160" fx:id="colDepartamenti"/>
                            <TableColumn text="%adminStafi.text.e.mail" prefWidth="200" fx:id="colEmail"/>
                            <TableColumn text="%adminStafi.text.statusi" prefWidth="120" fx:id="colStatusiStafit"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
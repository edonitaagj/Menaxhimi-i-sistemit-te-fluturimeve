<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.AdminAvionetController"
      prefWidth="1280" prefHeight="800"
      style="-fx-background-color: #F1F5F9;">

    <VBox prefWidth="260" minWidth="260" style="-fx-background-color: linear-gradient(to bottom, #091E36, #030A12);">
        <VBox style="-fx-padding: 28 24 24 24; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefWidth="40" prefHeight="40" style="-fx-background-color: rgba(58,148,242,0.15); -fx-background-radius: 10; -fx-border-color: #3A94F2; -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label text="⚙" style="-fx-text-fill: #3A94F2; -fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="PRN ADMIN" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: 900; -fx-letter-spacing: 0.05em;"/>
                    <Label text="Paneli i Menaxhimit" style="-fx-text-fill: rgba(133,183,235,0.45); -fx-font-size: 10; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox style="-fx-padding: 16 12 16 12;" spacing="4">
                <Label text="OPERACIONET" style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 12 12 4 12;"/>
                <HBox fx:id="navDashboard" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="📊" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="Dashboard" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>
                <HBox fx:id="navFluturimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="✈" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="Fluturimet &amp; Oraret" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>
                <HBox fx:id="navRezervimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="🎫" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="Rezervimet &amp; Pagesat" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <Label text="LOGJISTIKA" style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 20 12 4 12;"/>

                <HBox fx:id="navAvionet" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(58,148,242,0.15); -fx-border-color: #3A94F2; -fx-border-width: 0 0 0 3; -fx-padding: 11 16 11 13; -fx-cursor: hand;">
                    <Label text="🔧" style="-fx-font-size: 15;"/>
                    <Label text="Avionët &amp; Mirëmbajtja" style="-fx-text-fill: #3A94F2; -fx-font-size: 13; -fx-font-weight: 700;"/>
                </HBox>

                <HBox fx:id="navHumbur" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="🔍" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="Artikujt e Humbur" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <Label text="ADMINISTRIMI" style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 20 12 4 12;"/>
                <HBox fx:id="navStafi" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="👥" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="Menaxhimi i Stafit" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>
                <HBox fx:id="navPasagjeret" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="👤" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Pasagjerët" />
                </HBox>

                <HBox fx:id="navKompanite" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="🏢" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Kompanitë &amp; Linjat" />
                </HBox>
            </VBox>
        </ScrollPane>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox style="-fx-padding: 16 16 24 16; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1 0 0 0;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane prefHeight="36" prefWidth="36" style="-fx-background-color: #3A94F2; -fx-background-radius: 18;">
                    <Label fx:id="avatarLabel" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;" text="AD" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="userFullName" style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: 700;" text="Administrator" />
                    <Label fx:id="userEmail" style="-fx-text-fill: rgba(133,183,235,0.4); -fx-font-size: 10;" text="admin@prn-airport.com" />
                </VBox>
            </HBox>
            <Region prefHeight="15" />
            <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #F87171; -fx-font-size: 12; -fx-font-weight: 700; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: rgba(239,68,68,0.2); -fx-cursor: hand;" text="⟵  Dilni nga Sistemi" />
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 16 32 16 32; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <VBox>
                <Label text="REGJISTRI I FLOTËS AJRORE" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;"/>
                <Label text="Gjendja e Avionëve &amp; Logu i Mirëmbajtjes" style="-fx-text-fill: #0F172A; -fx-font-size: 22; -fx-font-weight: 900;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="12">
                <Button onAction="#handleShtoMirembajtje" text="🔧 Regjistro Shërbim Teknik" style="-fx-background-color: transparent; -fx-text-fill: #3A94F2; -fx-border-color: #3A94F2; -fx-border-radius: 8; -fx-font-weight: 700; -fx-padding: 10 16; -fx-cursor: hand;"/>
                <Button onAction="#handleShtoAvion" text="➕ Shto Avion të Ri" style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
            </HBox>
        </HBox>

        <VBox spacing="24" style="-fx-padding: 24;" VBox.vgrow="ALWAYS">

            <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.01), 10, 0, 0, 5);">
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24 8 24;">
                    <VBox spacing="2">
                        <Label text="Lista e Avionëve" style="-fx-text-fill: #0F172A; -fx-font-size: 15; -fx-font-weight: 800;"/>
                        <Label text="Selekto një avion për të parë historikun teknik" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 600;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtSearchAvioni" promptText="Kërko regjistrin (p.sh. OE-LWA)..." style="-fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 12; -fx-min-width: 250;"/>
                </HBox>

                <TableView fx:id="tblAvionet" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 4 12 12 12;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="ID" prefWidth="60" fx:id="colAvioniId"/>
                        <TableColumn text="REGJISTRI" prefWidth="140" fx:id="colNumriRegjistrit"/>
                        <TableColumn text="PRODHUESI" prefWidth="160" fx:id="colProdhuesi"/>
                        <TableColumn text="MODELI" prefWidth="160" fx:id="colModeli"/>
                        <TableColumn text="VITI I PRODHIMIT" prefWidth="130" fx:id="colVitiProdhimit"/>
                        <TableColumn text="STATUSI AKTUAL" prefWidth="160" fx:id="colStatusiAvionit"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.01), 10, 0, 0, 5);">
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24 8 24;">
                    <VBox spacing="2">
                        <Label text="Historiku i Mirëmbajtjes për Avionin e Përzgjedhur" style="-fx-text-fill: #0F172A; -fx-font-size: 15; -fx-font-weight: 800;"/>
                        <Label text="Urdhër-punët, kontrollet specifike dhe kostot e riparimeve" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 600;"/>
                    </VBox>
                </HBox>

                <TableView fx:id="tblMirembajtja" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 4 12 12 12;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="LLOJI I SHËRBIMIT" prefWidth="180" fx:id="colLlojiSherbimit"/>
                        <TableColumn text="DATA E FILLIMIT" prefWidth="160" fx:id="colDataFillimit"/>
                        <TableColumn text="DATA E MBARIMIT" prefWidth="160" fx:id="colDataMbarimit"/>
                        <TableColumn text="PËRSHKRIMI I PUNËS" prefWidth="250" fx:id="colPershkrimiPunes"/>
                        <TableColumn text="KOSTOJA (€)" prefWidth="120" fx:id="colKostoja"/>
                        <TableColumn text="STATUSI I PROCESIT" prefWidth="140" fx:id="colStatusiMirembajtjes"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

        </VBox>
    </VBox>
</HBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.AdminHumburController"
      prefWidth="1280" prefHeight="800"
      style="-fx-background-color: #F1F5F9;">

    <VBox prefWidth="260" style="-fx-background-color: linear-gradient(to bottom, #091E36, #030A12);">
        <VBox style="-fx-padding: 28 24 24 24; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefWidth="40" prefHeight="40" style="-fx-background-color: rgba(58,148,242,0.15); -fx-background-radius: 10; -fx-border-color: #3A94F2; -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label text="⚙" style="-fx-text-fill: #3A94F2; -fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="%sidebar.title" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: 900; -fx-letter-spacing: 0.05em;"/>
                    <Label text="%sidebar.subtitle" style="-fx-text-fill: rgba(133,183,235,0.45); -fx-font-size: 10; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox style="-fx-padding: 16 12 16 12;" spacing="4">
                <Label text="%sidebar.category.operations" style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 12 12 4 12;"/>
                <HBox fx:id="navDashboard" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="📊" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%menu.dashboard" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>
                <HBox fx:id="navFluturimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="✈" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%menu.flights" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>
                <HBox fx:id="navRezervimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="🎫" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%menu.bookings" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>

                <Label text="%sidebar.category.logistics" style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 20 12 4 12;"/>
                <HBox fx:id="navAvionet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="🔧" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%menu.planes" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>
                <HBox fx:id="navHumbur" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(58,148,242,0.15); -fx-border-color: #3A94F2; -fx-border-width: 0 0 0 3; -fx-padding: 11 16 11 13; -fx-cursor: hand;">
                    <Label text="🔍" style="-fx-font-size: 15;"/>
                    <Label text="%menu.lostfound" style="-fx-text-fill: #3A94F2; -fx-font-size: 13; -fx-font-weight: 700;"/>
                </HBox>

                <Label text="%sidebar.category.administration" style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 20 12 4 12;"/>
                <HBox fx:id="navStafi" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label text="👥" style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Label text="%menu.staff" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;"/>
                </HBox>
            </VBox>
        </ScrollPane>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox style="-fx-padding: 16 16 24 16; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1 0 0 0;">
            <Button onAction="#handleLogout" text="%button.logout" maxWidth="Infinity" style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #F87171; -fx-font-size: 12; -fx-font-weight: 700; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: rgba(239,68,68,0.2); -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 16 32 16 32; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <VBox>
                <Label text="%lostfound.header.systemName" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 800;"/>
                <Label text="%lostfound.header.pageTitle" style="-fx-text-fill: #0F172A; -fx-font-size: 22; -fx-font-weight: 900;"/>
            </VBox>
        </HBox>

        <HBox spacing="24" style="-fx-padding: 32;" VBox.vgrow="ALWAYS">

            <VBox prefWidth="360" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 15, 0, 0, 5); -fx-border-color: #E2E8F0; -fx-border-radius: 16;" spacing="15">
                <Label text="%lostfound.form.title" style="-fx-text-fill: #0F172A; -fx-font-size: 14; -fx-font-weight: 800;"/>

                <VBox spacing="6">
                    <Label text="%lostfound.form.itemName" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;"/>
                    <TextField fx:id="txtArtikulli" promptText="%lostfound.form.itemName.placeholder" style="-fx-background-radius: 6; -fx-padding: 8;"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="%lostfound.form.location" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;"/>
                    <TextField fx:id="txtVendi" promptText="%lostfound.form.location.placeholder" style="-fx-background-radius: 6; -fx-padding: 8;"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="%lostfound.form.date" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;"/>
                    <DatePicker fx:id="dtDataGjetjes" maxWidth="Infinity" style="-fx-background-radius: 6;"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="%lostfound.form.description" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;"/>
                    <TextArea fx:id="txtPershkrimi" promptText="%lostfound.form.description.placeholder" prefHeight="100" wrapText="true" style="-fx-background-radius: 6;"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="%lostfound.form.status" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;"/>
                    <ComboBox fx:id="cmbStatusiHumbur" promptText="%lostfound.form.status.placeholder" maxWidth="Infinity" style="-fx-background-radius: 6; -fx-padding: 4;"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>
                <Button onAction="#handleSaveArtikull" text="%lostfound.button.register" maxWidth="Infinity" style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.01), 10, 0, 0, 5);">
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 24 10 24;">
                    <TextField fx:id="txtSearchHumbur" promptText="%lostfound.search.placeholder" style="-fx-background-radius: 6; -fx-padding: 8 12; -fx-min-width: 250;"/>
                </HBox>
                <TableView fx:id="tblArtikujt" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn text="%lostfound.column.code" prefWidth="70" fx:id="colHumburId"/>
                        <TableColumn text="%lostfound.column.item" prefWidth="180" fx:id="colArtikulli"/>
                        <TableColumn text="%lostfound.column.location" prefWidth="160" fx:id="colVendi"/>
                        <TableColumn text="%lostfound.column.date" prefWidth="120" fx:id="colData"/>
                        <TableColumn text="%lostfound.column.status" prefWidth="130" fx:id="colStatusiHumbur"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </VBox>
</HBox>
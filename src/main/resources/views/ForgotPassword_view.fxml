<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ForgotPasswordController"
      prefWidth="860" prefHeight="600"
      style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 10);">

    <StackPane prefWidth="410"
               style="-fx-background-color: linear-gradient(to bottom right, #091E36, #030A12); -fx-background-radius: 16 0 0 16;">

        <VBox alignment="TOP_LEFT" spacing="0"
              style="-fx-padding: 40 32 32 32;">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefWidth="42" prefHeight="42"
                           style="-fx-background-color: rgba(55, 138, 221, 0.12);
                                  -fx-background-radius: 10;
                                  -fx-border-color: rgba(55, 138, 221, 0.3);
                                  -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label text="%forgotPassword.text.symbol" style="-fx-text-fill: #3A94F2; -fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="%forgotPassword.text.aeroporti.adem.jashari"
                           style="-fx-text-fill: white; -fx-font-size: 12;
                                  -fx-font-weight: 900; -fx-letter-spacing: 0.05em; -fx-font-family: 'System';"/>
                    <Label text="%forgotPassword.text.prn.pristina.international"
                           style="-fx-text-fill: rgba(133, 183, 235, 0.4);
                                  -fx-font-size: 11; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="%forgotPassword.text.prn"
                   style="-fx-text-fill: linear-gradient(to bottom, rgba(255,255,255,0.05), rgba(255,255,255,0.002));
                          -fx-font-size: 110; -fx-font-weight: 900;
                          -fx-font-family: 'System';"
                   alignment="CENTER"
                   maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="0"
                  style="-fx-background-color: rgba(255, 255, 255, 0.03);
                         -fx-border-color: rgba(255, 255, 255, 0.08);
                         -fx-border-width: 1; -fx-border-radius: 12;
                         -fx-background-radius: 12; -fx-padding: 16;">

                <HBox alignment="CENTER_LEFT">
                    <Label text="%forgotPassword.text.siguria.llogarise"
                           style="-fx-text-fill: rgba(255, 255, 255, 0.6);
                                  -fx-font-size: 11; -fx-font-weight: 800;
                                  -fx-letter-spacing: 0.08em;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER" spacing="5"
                          style="-fx-background-color: rgba(16, 185, 129, 0.15); -fx-padding: 3 8 3 8; -fx-background-radius: 20;">
                        <Circle radius="3.5" fill="#10B981"/>
                        <Label text="%forgotPassword.text.online"
                               style="-fx-text-fill: #10B981; -fx-font-size: 9;
                                      -fx-font-weight: 900; -fx-letter-spacing: 0.05em;"/>
                    </HBox>
                </HBox>

                <Region prefHeight="14"/>

                <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-padding: 8 0 8 0; -fx-border-color: rgba(255,255,255,0.05); -fx-border-width: 0 0 1 0;">
                    <Label text="%forgotPassword.text.hapi.1" prefWidth="70" style="-fx-text-fill: #85B7EB; -fx-font-size: 12; -fx-font-weight: 700;"/>
                    <Label text="%forgotPassword.text.verifikimi" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="%forgotPassword.text.username.email"
                           style="-fx-text-fill: #3A94F2;
                                  -fx-background-color: rgba(58, 148, 242, 0.12);
                                  -fx-border-color: rgba(58, 148, 242, 0.25);
                                  -fx-border-width: 1; -fx-border-radius: 6;
                                  -fx-background-radius: 6; -fx-padding: 4 8 4 8;
                                  -fx-font-size: 9; -fx-font-weight: 800;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-padding: 8 0 8 0; -fx-border-color: rgba(255,255,255,0.05); -fx-border-width: 0 0 1 0;">
                    <Label text="%forgotPassword.text.hapi.2" prefWidth="70" style="-fx-text-fill: #85B7EB; -fx-font-size: 12; -fx-font-weight: 700;"/>
                    <Label text="%forgotPassword.text.fjalekalim.i.ri" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="%forgotPassword.text.min.8"
                           style="-fx-text-fill: #10B981;
                                  -fx-background-color: rgba(16, 185, 129, 0.12);
                                  -fx-border-color: rgba(16, 185, 129, 0.25);
                                  -fx-border-width: 1; -fx-border-radius: 6;
                                  -fx-background-radius: 6; -fx-padding: 4 8 4 8;
                                  -fx-font-size: 9; -fx-font-weight: 800;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-padding: 8 0 0 0;">
                    <Label text="%forgotPassword.text.hapi.3" prefWidth="70" style="-fx-text-fill: #85B7EB; -fx-font-size: 12; -fx-font-weight: 700;"/>
                    <Label text="%forgotPassword.text.hyrja" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="%forgotPassword.text.gati"
                           style="-fx-text-fill: #F59E0B;
                                  -fx-background-color: rgba(245, 158, 11, 0.12);
                                  -fx-border-color: rgba(245, 158, 11, 0.25);
                                  -fx-border-width: 1; -fx-border-radius: 6;
                                  -fx-background-radius: 6; -fx-padding: 4 8 4 8;
                                  -fx-font-size: 9; -fx-font-weight: 800;"/>
                </HBox>
            </VBox>
        </VBox>
    </StackPane>

    <VBox prefWidth="450" alignment="CENTER_LEFT"
          style="-fx-background-color: white;
                 -fx-background-radius: 0 16 16 0;
                 -fx-padding: 42 50 42 50;"
          spacing="0">

        <HBox alignment="CENTER_RIGHT" maxWidth="Infinity">
            <Button fx:id="languageButton"
                    text="%language.switch"
                    onAction="#handleLanguageSwitch"
                    style="-fx-background-color: #F8FAFC;
                           -fx-text-fill: #0F172A;
                           -fx-font-size: 12; -fx-font-weight: 800;
                           -fx-border-color: #CBD5E1; -fx-border-width: 1;
                           -fx-border-radius: 8; -fx-background-radius: 8;
                           -fx-cursor: hand; -fx-padding: 7 12 7 12;"/>
        </HBox>

        <Region prefHeight="22"/>

        <Label text="%forgotPassword.text.rikthe.fjalekalimin"
               style="-fx-text-fill: #0F172A; -fx-font-size: 30;
                      -fx-font-weight: 900; -fx-font-family: 'System'"/>
        <Region prefHeight="4"/>
        <Label text="%forgotPassword.text.shkruani.te.dhenat"
               style="-fx-text-fill: #64748B; -fx-font-size: 13; -fx-font-weight: 500;"/>

        <Region prefHeight="22"/>

        <HBox fx:id="errBox" alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #FEF2F2;
                     -fx-border-color: #FCA5A5; -fx-border-width: 1;
                     -fx-border-radius: 10; -fx-background-radius: 10;
                     -fx-padding: 12 16 12 16;"
              visible="false" managed="false">
            <Label text="%forgotPassword.text.error.symbol" style="-fx-text-fill: #DC2626; -fx-font-size: 14;"/>
            <Label fx:id="errLabel"
                   text="%forgotPassword.error.requiredFields"
                   style="-fx-text-fill: #DC2626; -fx-font-size: 13; -fx-font-weight: 700;"/>
        </HBox>
        <Region fx:id="errSpacer" prefHeight="12" visible="false" managed="false"/>

        <HBox fx:id="successBox" alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #ECFDF5;
                     -fx-border-color: #86EFAC; -fx-border-width: 1;
                     -fx-border-radius: 10; -fx-background-radius: 10;
                     -fx-padding: 12 16 12 16;"
              visible="false" managed="false">
            <Label text="%forgotPassword.text.success.symbol" style="-fx-text-fill: #16A34A; -fx-font-size: 14;"/>
            <Label fx:id="successLabel"
                   text="%forgotPassword.success.passwordUpdated"
                   style="-fx-text-fill: #15803D; -fx-font-size: 13; -fx-font-weight: 700;"/>
        </HBox>
        <Region fx:id="successSpacer" prefHeight="12" visible="false" managed="false"/>

        <Label text="%forgotPassword.text.username"
               style="-fx-text-fill: #475569; -fx-font-size: 11;
                      -fx-font-weight: 800; -fx-letter-spacing: 0.06em;"/>
        <Region prefHeight="8"/>
        <StackPane alignment="CENTER_RIGHT" maxWidth="Infinity">
            <TextField fx:id="usernameField"
                       promptText="%forgotPassword.promptText.username"
                       style="-fx-background-color: #F8FAFC;
                              -fx-border-color: #E2E8F0; -fx-border-width: 1.5;
                              -fx-border-radius: 10; -fx-background-radius: 10;
                              -fx-padding: 13 45 13 16;
                              -fx-font-size: 14; -fx-text-fill: #0F172A;
                              -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 600;"
                       maxWidth="Infinity"/>
            <Label text="%forgotPassword.text.username.symbol" style="-fx-text-fill: #94A3B8; -fx-font-size: 18; -fx-padding: 0 16 0 0;"/>
        </StackPane>

        <Region prefHeight="16"/>

        <Label text="%forgotPassword.text.email"
               style="-fx-text-fill: #475569; -fx-font-size: 11;
                      -fx-font-weight: 800; -fx-letter-spacing: 0.06em;"/>
        <Region prefHeight="8"/>
        <StackPane alignment="CENTER_RIGHT" maxWidth="Infinity">
            <TextField fx:id="emailField"
                       promptText="%forgotPassword.promptText.email"
                       style="-fx-background-color: #F8FAFC;
                              -fx-border-color: #E2E8F0; -fx-border-width: 1.5;
                              -fx-border-radius: 10; -fx-background-radius: 10;
                              -fx-padding: 13 45 13 16;
                              -fx-font-size: 14; -fx-text-fill: #0F172A;
                              -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 600;"
                       maxWidth="Infinity"/>
            <Label text="%forgotPassword.text.email.symbol" style="-fx-text-fill: #94A3B8; -fx-font-size: 16; -fx-padding: 0 16 0 0;"/>
        </StackPane>

        <Region prefHeight="16"/>

        <Label text="%forgotPassword.text.fjalekalimi.i.ri"
               style="-fx-text-fill: #475569; -fx-font-size: 11;
                      -fx-font-weight: 800; -fx-letter-spacing: 0.06em;"/>
        <Region prefHeight="8"/>
        <StackPane alignment="CENTER_RIGHT" maxWidth="Infinity">
            <PasswordField fx:id="newPasswordField"
                           promptText="%forgotPassword.promptText.password"
                           style="-fx-background-color: #F8FAFC;
                                  -fx-border-color: #E2E8F0; -fx-border-width: 1.5;
                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                  -fx-padding: 13 45 13 16;
                                  -fx-font-size: 14; -fx-text-fill: #0F172A;
                                  -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 600;"
                           maxWidth="Infinity"/>
            <Label text="%forgotPassword.text.password.symbol" style="-fx-text-fill: #94A3B8; -fx-font-size: 16; -fx-padding: 0 16 0 0;"/>
        </StackPane>

        <Region prefHeight="16"/>

        <Label text="%forgotPassword.text.konfirmo.fjalekalimin"
               style="-fx-text-fill: #475569; -fx-font-size: 11;
                      -fx-font-weight: 800; -fx-letter-spacing: 0.06em;"/>
        <Region prefHeight="8"/>
        <StackPane alignment="CENTER_RIGHT" maxWidth="Infinity">
            <PasswordField fx:id="confirmPasswordField"
                           promptText="%forgotPassword.promptText.password"
                           style="-fx-background-color: #F8FAFC;
                                  -fx-border-color: #E2E8F0; -fx-border-width: 1.5;
                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                  -fx-padding: 13 45 13 16;
                                  -fx-font-size: 14; -fx-text-fill: #0F172A;
                                  -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 600;"
                           maxWidth="Infinity"/>
            <Label text="%forgotPassword.text.confirm.symbol" style="-fx-text-fill: #94A3B8; -fx-font-size: 16; -fx-padding: 0 16 0 0;"/>
        </StackPane>

        <Region prefHeight="24"/>

        <Button fx:id="resetBtn"
                text="%forgotPassword.text.ndrysho.fjalekalimin"
                onAction="#handleResetPassword"
                maxWidth="Infinity"
                style="-fx-background-color: linear-gradient(to right, #091E36, #122D4F);
                       -fx-text-fill: white;
                       -fx-font-size: 15; -fx-font-weight: 800;
                       -fx-background-radius: 10;
                       -fx-cursor: hand; -fx-padding: 14 0 14 0;
                       -fx-letter-spacing: 0.02em;
                       -fx-effect: dropshadow(three-pass-box, rgba(9,30,54,0.2), 10, 0, 0, 4);"/>

        <Region prefHeight="12"/>

        <Button fx:id="loginBtn"
                text="%forgotPassword.text.kthehu.ne.login"
                onAction="#handleBackToLogin"
                maxWidth="Infinity"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #334155;
                       -fx-font-size: 14; -fx-font-weight: 700;
                       -fx-border-color: #CBD5E1; -fx-border-width: 1.5;
                       -fx-border-radius: 10; -fx-background-radius: 10;
                       -fx-cursor: hand; -fx-padding: 13 0 13 0;"/>
    </VBox>
</HBox>
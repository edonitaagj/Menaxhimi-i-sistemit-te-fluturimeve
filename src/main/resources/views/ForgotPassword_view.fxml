<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ForgotPasswordController"
      prefWidth="860" prefHeight="600"
      style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 10);">

    <StackPane prefWidth="410"
               style="-fx-background-color: linear-gradient(to bottom right, #091E36, #030A12); -fx-background-radius: 16 0 0 16;">

        <VBox alignment="TOP_LEFT" spacing="0" style="-fx-padding: 40 32 32 32;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefWidth="42" prefHeight="42"
                           style="-fx-background-color: rgba(55, 138, 221, 0.12); -fx-background-radius: 10; -fx-border-color: rgba(55, 138, 221, 0.3); -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label text="PRN" style="-fx-text-fill: #3A94F2; -fx-font-size: 13; -fx-font-weight: 900;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="AEROPORTI ADEM JASHARI"
                           style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: 900;"/>
                    <Label text="Rikthim i qasjes"
                           style="-fx-text-fill: rgba(133, 183, 235, 0.4); -fx-font-size: 11; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="RESET"
                   alignment="CENTER"
                   maxWidth="Infinity"
                   style="-fx-text-fill: linear-gradient(to bottom, rgba(255,255,255,0.07), rgba(255,255,255,0.005)); -fx-font-size: 78; -fx-font-weight: 900;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="12"
                  style="-fx-background-color: rgba(255, 255, 255, 0.03); -fx-border-color: rgba(255, 255, 255, 0.08); -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 18;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="SIGURIA E LLOGARISE"
                           style="-fx-text-fill: rgba(255, 255, 255, 0.62); -fx-font-size: 11; -fx-font-weight: 800;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER" spacing="5"
                          style="-fx-background-color: rgba(16, 185, 129, 0.15); -fx-padding: 3 8 3 8; -fx-background-radius: 20;">
                        <Circle radius="3.5" fill="#10B981"/>
                        <Label text="ACTIVE"
                               style="-fx-text-fill: #10B981; -fx-font-size: 9; -fx-font-weight: 900;"/>
                    </HBox>
                </HBox>

                <Label wrapText="true"
                       text="Shkruani username dhe email-in e llogarise. Nese perputhen me databazen, fjalekalimi i ri ruhet ne menyre te sigurt."
                       style="-fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12; -fx-line-spacing: 3;"/>
            </VBox>
        </VBox>
    </StackPane>

    <VBox prefWidth="450" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-background-radius: 0 16 16 0; -fx-padding: 46 50 46 50;"
          spacing="0">

        <Label text="Harruat fjalekalimin?"
               style="-fx-text-fill: #0F172A; -fx-font-size: 30; -fx-font-weight: 900;"/>
        <Region prefHeight="6"/>
        <Label text="Verifikoni llogarine dhe vendosni fjalekalimin e ri."
               wrapText="true"
               style="-fx-text-fill: #64748B; -fx-font-size: 13; -fx-font-weight: 500;"/>

        <Region prefHeight="28"/>

        <HBox fx:id="messageBox" alignment="CENTER_LEFT" spacing="10"
              visible="false" managed="false">
            <Label fx:id="messageIcon" text="!" />
            <Label fx:id="messageLabel" wrapText="true" text="Mesazh" />
        </HBox>
        <Region fx:id="messageSpacer" prefHeight="16" visible="false" managed="false"/>

        <Label text="USERNAME"
               style="-fx-text-fill: #475569; -fx-font-size: 11; -fx-font-weight: 800;"/>
        <Region prefHeight="8"/>
        <TextField fx:id="usernameField"
                   promptText="username"
                   style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14 16 14 16; -fx-font-size: 14; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 600;"
                   maxWidth="Infinity"/>

        <Region prefHeight="16"/>

        <Label text="EMAIL"
               style="-fx-text-fill: #475569; -fx-font-size: 11; -fx-font-weight: 800;"/>
        <Region prefHeight="8"/>
        <TextField fx:id="emailField"
                   promptText="email@domain.com"
                   style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14 16 14 16; -fx-font-size: 14; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 600;"
                   maxWidth="Infinity"/>

        <Region prefHeight="16"/>

        <Label text="FJALEKALIMI I RI"
               style="-fx-text-fill: #475569; -fx-font-size: 11; -fx-font-weight: 800;"/>
        <Region prefHeight="8"/>
        <PasswordField fx:id="newPasswordField"
                       promptText="Minimum 6 karaktere"
                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14 16 14 16; -fx-font-size: 14; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 600;"
                       maxWidth="Infinity"/>

        <Region prefHeight="16"/>

        <Label text="KONFIRMO FJALEKALIMIN"
               style="-fx-text-fill: #475569; -fx-font-size: 11; -fx-font-weight: 800;"/>
        <Region prefHeight="8"/>
        <PasswordField fx:id="confirmPasswordField"
                       promptText="Perserite fjalekalimin"
                       onAction="#handleResetPassword"
                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14 16 14 16; -fx-font-size: 14; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8; -fx-font-weight: 600;"
                       maxWidth="Infinity"/>

        <Region prefHeight="26"/>

        <Button text="Ndrysho fjalekalimin"
                onAction="#handleResetPassword"
                maxWidth="Infinity"
                style="-fx-background-color: linear-gradient(to right, #091E36, #122D4F); -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: 800; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 14 0 14 0; -fx-effect: dropshadow(three-pass-box, rgba(9,30,54,0.2), 10, 0, 0, 4);"/>

        <Region prefHeight="12"/>

        <Button text="Kthehu te Login"
                onAction="#handleBackToLogin"
                maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #334155; -fx-font-size: 14; -fx-font-weight: 700; -fx-border-color: #CBD5E1; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 13 0 13 0;"/>
    </VBox>
</HBox>

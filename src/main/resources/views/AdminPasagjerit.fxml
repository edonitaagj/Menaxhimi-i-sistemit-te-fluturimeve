<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="800" prefWidth="1280" style="-fx-background-color: #F1F5F9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminPasagjeretController">

    <VBox minWidth="260" prefWidth="260" style="-fx-background-color: linear-gradient(to bottom, #091E36, #030A12); -fx-padding: 0;">

        <VBox style="-fx-padding: 28 24 24 24; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="40" prefWidth="40" style="-fx-background-color: rgba(58,148,242,0.15); -fx-background-radius: 10; -fx-border-color: #3A94F2; -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label style="-fx-text-fill: #3A94F2; -fx-font-size: 20;" text="%adminPasagjerit.text.symbol" />
                </StackPane>
                <VBox spacing="1">
                    <Label style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: 900; -fx-letter-spacing: 0.05em;" text="%adminPasagjerit.text.prn.admin" />
                    <Label style="-fx-text-fill: rgba(133,183,235,0.45); -fx-font-size: 10; -fx-font-weight: 600;" text="%adminPasagjerit.text.paneli.i.menaxhimit" />
                </VBox>
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="4" style="-fx-padding: 16 12 16 12;">

                <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 12 12 4 12;" text="%adminPasagjerit.text.operacionet" />

                <HBox fx:id="navDashboard" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%adminPasagjerit.text.symbol.2" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="%adminPasagjerit.text.dashboard" />
                </HBox>

                <HBox fx:id="navFluturimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%adminPasagjerit.text.symbol.3" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="%adminPasagjerit.text.fluturimet.and.oraret" />
                </HBox>

                <HBox fx:id="navRezervimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%adminPasagjerit.text.symbol.4" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="%adminPasagjerit.text.rezervimet.and.pagesat" />
                </HBox>

                <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 20 12 4 12;" text="%adminPasagjerit.text.logjistika" />

                <HBox fx:id="navAvionet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%adminPasagjerit.text.symbol.5" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="%adminPasagjerit.text.avionet.and.mirembajtja" />
                </HBox>

                <HBox fx:id="navHumbur" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%adminPasagjerit.text.symbol.6" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="%adminPasagjerit.text.artikujt.e.humbur" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-size: 8; -fx-font-weight: 900; -fx-padding: 1 4 1 4; -fx-background-radius: 4;" text="%adminPasagjerit.text.new" />
                </HBox>

                <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 20 12 4 12;" text="%adminPasagjerit.text.administrimi" />

                <HBox fx:id="navStafi" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%adminPasagjerit.text.symbol.7" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="%adminPasagjerit.text.menaxhimi.i.stafit" />
                </HBox>

                <HBox fx:id="navPasagjeret" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(58,148,242,0.15); -fx-border-color: #3A94F2; -fx-border-width: 0 0 0 3; -fx-padding: 11 16 11 13; -fx-cursor: hand;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: #3A94F2;" text="%adminPasagjerit.text.symbol.8" />
                    <Label style="-fx-text-fill: #3A94F2; -fx-font-size: 13; -fx-font-weight: 700;" text="%adminPasagjerit.text.pasagjeret" />
                </HBox>

                <HBox fx:id="navKompanite" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%adminPasagjerit.text.symbol.9" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="%adminPasagjerit.text.kompanite.and.linjat" />
                </HBox>
            </VBox>
        </ScrollPane>

        <Region VBox.vgrow="ALWAYS" />

        <VBox style="-fx-padding: 16 16 24 16; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1 0 0 0;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane prefHeight="36" prefWidth="36" style="-fx-background-color: #3A94F2; -fx-background-radius: 18;">
                    <Label fx:id="avatarLabel" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800;" text="%adminPasagjerit.text.ad" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="userFullName" style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: 700;" text="%adminPasagjerit.text.administrator" />
                    <Label fx:id="userEmail" style="-fx-text-fill: rgba(133,183,235,0.4); -fx-font-size: 10;" text="%adminPasagjerit.text.admin.prn.airport.com" />
                </VBox>
            </HBox>
            <Region prefHeight="15" />
            <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #F87171; -fx-font-size: 12; -fx-font-weight: 700; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: rgba(239,68,68,0.2); -fx-cursor: hand;" text="%adminPasagjerit.text.dilni.nga.sistemi" />
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 16 32 16 32; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <VBox>
                <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12; -fx-font-weight: 600;" text="%adminPasagjerit.text.sistemi.i.menaxhimit.te.aeroportit" />
                <Label style="-fx-text-fill: #0F172A; -fx-font-size: 22; -fx-font-weight: 900;" text="%adminPasagjerit.text.gjenerali.i.pasagjereve" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane prefHeight="40" prefWidth="40" style="-fx-background-color: #F1F5F9; -fx-background-radius: 20;">
                    <Label style="-fx-font-size: 16;" text="%adminPasagjerit.text.symbol.10" />
                </StackPane>
            </HBox>
        </HBox>

        <HBox spacing="24" style="-fx-padding: 24;" VBox.vgrow="ALWAYS">

            <VBox prefHeight="670.0" prefWidth="475.0" spacing="16" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);">
                <Label style="-fx-text-fill: #0F172A; -fx-font-size: 15; -fx-font-weight: 800;" text="%adminPasagjerit.text.menaxho.pasagjer" />

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox spacing="14" style="-fx-padding: 2 4 2 2;">
                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="%adminPasagjerit.text.numri.i.pasaportes" />
                            <TextField fx:id="txtNumriPasaportes" promptText="%adminPasagjerit.promptText.p.sh.xk1234567" style="-fx-background-radius: 6; -fx-padding: 8;" />
                        </VBox>

                        <HBox spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="%adminPasagjerit.text.emri" />
                                <TextField fx:id="txtEmri" promptText="%adminPasagjerit.promptText.ardian" style="-fx-background-radius: 6; -fx-padding: 8;" />
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="%adminPasagjerit.text.mbiemri" />
                                <TextField fx:id="txtMbiemri" promptText="%adminPasagjerit.promptText.krasniqi" style="-fx-background-radius: 6; -fx-padding: 8;" />
                            </VBox>
                        </HBox>

                        <HBox spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="%adminPasagjerit.text.shtetesia.id" />
                                <ComboBox fx:id="cmbShtetesia" maxWidth="Infinity" promptText="%adminPasagjerit.promptText.zgjidh" style="-fx-background-radius: 6; -fx-padding: 4;" />
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="%adminPasagjerit.text.gjinia" />
                                <ComboBox fx:id="cmbGjinia" maxWidth="Infinity" promptText="%adminPasagjerit.promptText.zgjidh" style="-fx-background-radius: 6; -fx-padding: 4;" />
                            </VBox>
                        </HBox>

                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="%adminPasagjerit.text.datelindja" />
                            <DatePicker fx:id="dpDatelindja" maxWidth="Infinity" style="-fx-background-radius: 6;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="%adminPasagjerit.text.email.adresa" />
                            <TextField fx:id="txtEmail" promptText="%adminPasagjerit.promptText.emri.shembull.com" style="-fx-background-radius: 6; -fx-padding: 8;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="%adminPasagjerit.text.numri.i.telefonit" />
                            <TextField fx:id="txtTelefoni" promptText="%adminPasagjerit.promptText.38344100200" style="-fx-background-radius: 6; -fx-padding: 8;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="%adminPasagjerit.text.adresa.e.banimit" />
                            <TextField fx:id="txtAdresa" promptText="%adminPasagjerit.promptText.p.sh.rruga.agim.ramadani.prishtine" style="-fx-background-radius: 6; -fx-padding: 8;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 700;" text="%adminPasagjerit.text.skadimi.i.pasaportes" />
                            <DatePicker fx:id="dpPasaportaSkadimi" maxWidth="Infinity" style="-fx-background-radius: 6;" />
                        </VBox>
                    </VBox>
                </ScrollPane>

                <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
                    <Button maxWidth="Infinity" onAction="#handleSavePasagjer" style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;" text="%adminPasagjerit.text.ruaj.te.dhenat" />
                    <HBox spacing="10">
                        <Button maxWidth="Infinity" onAction="#handleClearForm" style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-font-weight: 700; -fx-background-radius: 8; -fx-padding: 8; -fx-cursor: hand;" text="%adminPasagjerit.text.pastro" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnDeletePasagjer" disable="true" maxWidth="Infinity" onAction="#handleDeletePasagjer" style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #EF4444; -fx-font-weight: 700; -fx-background-radius: 8; -fx-padding: 8; -fx-cursor: hand;" text="%adminPasagjerit.text.fshij" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>
            </VBox>

            <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-width: 1;" HBox.hgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 24 16 24; -fx-border-color: #F1F5F9; -fx-border-width: 0 0 1 0;">
                    <VBox spacing="2">
                        <Label style="-fx-text-fill: #0F172A; -fx-font-size: 16; -fx-font-weight: 900;" text="%adminPasagjerit.text.regjistri.i.pasagjereve" />
                        <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: 600;" text="%adminPasagjerit.text.lista.e.te.gjithe.pasagjereve.te.regjistruar.ne" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox spacing="10">
                        <TextField fx:id="txtSearchPasagjeri" onKeyReleased="#handleSearchPasagjeri" promptText="%adminPasagjerit.promptText.kerko.me.emer.mbiemer.ose.pasaporte" style="-fx-background-radius: 8; -fx-min-width: 280; -fx-padding: 8;" />
                    </HBox>
                </HBox>

                <TableView fx:id="tblPasagjeret" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 12 0 12;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50" text="%adminPasagjerit.text.id" />
                        <TableColumn fx:id="colPasaporta" prefWidth="100" text="%adminPasagjerit.text.pasaporta" />
                        <TableColumn fx:id="colEmri" prefWidth="110" text="%adminPasagjerit.text.emri.2" />
                        <TableColumn fx:id="colMbiemri" prefWidth="110" text="%adminPasagjerit.text.mbiemri.2" />
                        <TableColumn fx:id="colShtetesia" prefWidth="90" text="%adminPasagjerit.text.shtetesia" />
                        <TableColumn fx:id="colGjinia" prefWidth="60" text="%adminPasagjerit.text.gjinia.2" />
                        <TableColumn fx:id="colEmail" prefWidth="160" text="%adminPasagjerit.text.email" />
                        <TableColumn fx:id="colTelefoni" prefWidth="120" text="%adminPasagjerit.text.telefoni" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 16 24 16 24; -fx-background-color: #F8FAFC; -fx-background-radius: 0 0 16 16; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
                    <HBox alignment="CENTER" spacing="5">
                        <Button onAction="#handlePreviousPage" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 6; -fx-cursor: hand;" text="%adminPasagjerit.text.meparshme" />
                        <Label fx:id="lblPagination" style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-padding: 0 15 0 15;" text="%adminPasagjerit.text.faqja.1.nga.1" />
                        <Button onAction="#handleNextPage" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 6; -fx-cursor: hand;" text="%adminPasagjerit.text.tjetra" />
                    </HBox>
                </HBox>
            </VBox>

        </HBox>
    </VBox>
</HBox>

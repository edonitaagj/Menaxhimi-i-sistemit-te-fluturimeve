<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="760" prefWidth="1200" style="-fx-background-color: #F1F5F9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RezervimetController">

    <VBox prefWidth="220" style="-fx-background-color: linear-gradient(to bottom, #091E36, #030A12); -fx-padding: 0;">
        <VBox style="-fx-padding: 28 24 24 24; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="38" prefWidth="38" style="-fx-background-color: rgba(55,138,221,0.15); -fx-background-radius: 10; -fx-border-color: rgba(55,138,221,0.3); -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label style="-fx-text-fill: #3A94F2; -fx-font-size: 18;" text="%rezervimet.text.symbol" />
                </StackPane>
                <VBox spacing="1">
                    <Label style="-fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: 900;" text="%rezervimet.text.adem.jashari" />
                    <Label style="-fx-text-fill: rgba(133,183,235,0.45); -fx-font-size: 10; -fx-font-weight: 600;" text="%rezervimet.text.prn.klient" />
                </VBox>
            </HBox>
        </VBox>
        <VBox spacing="4" style="-fx-padding: 16 12 16 12;">
            <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.08em; -fx-padding: 8 12 4 12;" text="%rezervimet.text.navigimi" />
            <HBox fx:id="navHome" alignment="CENTER_LEFT" onMouseClicked="#handleNavHome" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%rezervimet.text.symbol.2" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13; -fx-font-weight: 600;" text="%rezervimet.text.kryefaqja" />
            </HBox>
            <HBox fx:id="navRezervimet" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(58,148,242,0.15); -fx-border-color: rgba(58,148,242,0.4); -fx-border-width: 0 0 0 3; -fx-background-radius: 0 8 8 0; -fx-padding: 11 16 11 13; -fx-cursor: hand;">
                <Label style="-fx-font-size: 15;" text="%rezervimet.text.symbol.3" />
                <Label style="-fx-text-fill: #3A94F2; -fx-font-size: 13; -fx-font-weight: 700;" text="%rezervimet.text.rezervimet.e.mia" />
            </HBox>
            <HBox fx:id="navBileta" alignment="CENTER_LEFT" onMouseClicked="#handleNavBileta" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%rezervimet.text.symbol.4" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13; -fx-font-weight: 600;" text="%rezervimet.text.biletat.e.mia" />
            </HBox>
            <HBox fx:id="navNjoftimet" alignment="CENTER_LEFT" onMouseClicked="#handleNavNjoftimet" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%rezervimet.text.symbol.5" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13; -fx-font-weight: 600;" text="%rezervimet.text.njoftime" />
            </HBox>
            <HBox fx:id="navHelp"
                  alignment="CENTER_LEFT"
                  spacing="12"
                  onMouseClicked="#handleNavHelp"
                  style="-fx-padding: 11 16 11 16;
             -fx-cursor: hand;
             -fx-background-radius: 8;">

                <Label text="%rezervimet.text.symbol.6"
                       style="-fx-font-size: 15;
                  -fx-text-fill: rgba(255,255,255,0.5);" />

                <Label text="%rezervimet.text.ndihme"
                       style="-fx-text-fill: rgba(255,255,255,0.6);
                  -fx-font-size: 13;
                  -fx-font-weight: 600;" />
            </HBox>
            <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.08em; -fx-padding: 12 12 4 12;" text="%rezervimet.text.llogaria" />
            <HBox fx:id="navProfili" alignment="CENTER_LEFT" onMouseClicked="#handleNavProfili" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="%rezervimet.text.symbol.7" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13; -fx-font-weight: 600;" text="%rezervimet.text.profili.im" />
            </HBox>
        </VBox>
        <Region VBox.vgrow="ALWAYS" />
        <VBox style="-fx-padding: 16 16 24 16;                      -fx-border-color: rgba(255,255,255,0.07);                      -fx-border-width: 1 0 0 0;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane prefHeight="36" prefWidth="36" style="-fx-background-color: rgba(58,148,242,0.2);                                   -fx-background-radius: 18;">
                    <Label fx:id="avatarLabel" style="-fx-text-fill: #3A94F2; -fx-font-size: 15; -fx-font-weight: 800;" text="%rezervimet.text.a" />
                </StackPane>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="userFullName" style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: 700;" text="%rezervimet.text.ardian.krasniqi" />
                    <Label fx:id="userEmail" style="-fx-text-fill: rgba(133,183,235,0.4); -fx-font-size: 11;" text="%rezervimet.text.ardian.email.com" />
                </VBox>
            </HBox>
            <Region prefHeight="12" />
            <Button fx:id="logoutBtn" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: rgba(239,68,68,0.1);                            -fx-text-fill: #F87171;                            -fx-font-size: 12; -fx-font-weight: 700;                            -fx-background-radius: 8; -fx-cursor: hand;                            -fx-border-color: rgba(239,68,68,0.2);                            -fx-border-radius: 8; -fx-border-width: 1;                            -fx-padding: 8 0 8 0;" text="%rezervimet.text.dilni" />
        </VBox>
    </VBox>

    <VBox style="-fx-background-color: #F1F5F9; -fx-padding: 0;" HBox.hgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 16 28 16 28; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <VBox spacing="2">
                <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12; -fx-font-weight: 600;" text="%rezervimet.text.menaxhimi.i.biletave" />
                <Label style="-fx-text-fill: #0F172A; -fx-font-size: 20; -fx-font-weight: 900;" text="%rezervimet.text.historiku.i.rezervimeve" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#handleHapModalRezervim" style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 10 16; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(58,148,242,0.3), 8, 0, 0, 3);" text="%rezervimet.text.rezervo.fluturim" />
        </HBox>

        <VBox style="-fx-padding: 24;" VBox.vgrow="ALWAYS">
            <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 14;" VBox.vgrow="ALWAYS">
                <TableView fx:id="tblRezervimet" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 12;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colKodiRezervimit" prefWidth="110" text="%rezervimet.text.kodi" />
                        <TableColumn fx:id="colFluturimi" prefWidth="100" text="%rezervimet.text.fluturimi" />
                        <TableColumn fx:id="colRelacioni" prefWidth="180" text="%rezervimet.text.relacioni" />
                        <TableColumn fx:id="colData" prefWidth="120" text="%rezervimet.text.data.rezervimit" />
                        <TableColumn fx:id="colKlasa" prefWidth="100" text="%rezervimet.text.klasa" />
                        <TableColumn fx:id="colCmimi" prefWidth="100" text="%rezervimet.text.cmimi.total" />
                        <TableColumn fx:id="colStatusi" prefWidth="120" text="%rezervimet.text.statusi" />
                        <TableColumn fx:id="colVeprimet" prefWidth="140" text="%rezervimet.text.veprimet" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </VBox>
</HBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="760" prefWidth="1200" style="-fx-background-color: #F1F5F9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RezervimetController">

    <VBox prefWidth="220" style="-fx-background-color: linear-gradient(to bottom, #091E36, #030A12); -fx-padding: 0;">
        <VBox style="-fx-padding: 28 24 24 24; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="38" prefWidth="38" style="-fx-background-color: rgba(55,138,221,0.15); -fx-background-radius: 10; -fx-border-color: rgba(55,138,221,0.3); -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label style="-fx-text-fill: #3A94F2; -fx-font-size: 18;" text="✈" />
                </StackPane>
                <VBox spacing="1">
                    <Label style="-fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: 900;" text="%client.nav.title" />
                    <Label style="-fx-text-fill: rgba(133,183,235,0.45); -fx-font-size: 10; -fx-font-weight: 600;" text="%client.nav.subtitle" />
                </VBox>
            </HBox>
        </VBox>
        <VBox spacing="4" style="-fx-padding: 16 12 16 12;">
            <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.08em; -fx-padding: 8 12 4 12;" text="%client.nav.cat.navigation" />

            <HBox fx:id="navHome" alignment="CENTER_LEFT" onMouseClicked="#handleNavHome" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="🏠" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13; -fx-font-weight: 600;" text="%client.nav.item.home" />
            </HBox>

            <HBox fx:id="navRezervimet" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(58,148,242,0.15); -fx-border-color: rgba(58,148,242,0.4); -fx-border-width: 0 0 0 3; -fx-background-radius: 0 8 8 0; -fx-padding: 11 16 11 13; -fx-cursor: hand;">
                <Label style="-fx-font-size: 15;" text="🎫" />
                <Label style="-fx-text-fill: #3A94F2; -fx-font-size: 13; -fx-font-weight: 700;" text="%client.nav.item.myreservations" />
            </HBox>

            <HBox fx:id="navBileta" alignment="CENTER_LEFT" onMouseClicked="#handleNavBileta" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="📋" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13; -fx-font-weight: 600;" text="%client.nav.item.mytickets" />
            </HBox>

            <HBox fx:id="navNjoftimet" alignment="CENTER_LEFT" onMouseClicked="#handleNavNjoftimet" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="🔔" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13; -fx-font-weight: 600;" text="%client.nav.item.notifications" />
            </HBox>

            <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.08em; -fx-padding: 12 12 4 12;" text="%client.nav.cat.account" />

            <HBox fx:id="navProfili" alignment="CENTER_LEFT" onMouseClicked="#handleNavProfili" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="👤" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13; -fx-font-weight: 600;" text="%client.nav.item.profile" />
            </HBox>
        </VBox>
        <Region VBox.vgrow="ALWAYS" />
        <VBox style="-fx-padding: 16 16 24 16; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1 0 0 0;">
            <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #F87171; -fx-font-size: 12; -fx-font-weight: 700; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: rgba(239,68,68,0.2); -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 8 0 8 0;" text="%client.button.logout" />
        </VBox>
    </VBox>

    <VBox style="-fx-background-color: #F1F5F9; -fx-padding: 0;" HBox.hgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 16 28 16 28; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <VBox spacing="2">
                <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12; -fx-font-weight: 600;" text="%client.res.header.category" />
                <Label style="-fx-text-fill: #0F172A; -fx-font-size: 20; -fx-font-weight: 900;" text="%client.res.header.title" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#handleHapModalRezervim" style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 10 16; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(58,148,242,0.3), 8, 0, 0, 3);" text="%client.res.action.new" />
        </HBox>

        <VBox style="-fx-padding: 24;" VBox.vgrow="ALWAYS">
            <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 14;" VBox.vgrow="ALWAYS">
                <TableView fx:id="tblRezervimet" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 12;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colKodiRezervimit" prefWidth="110" text="%client.res.col.code" />
                        <TableColumn fx:id="colFluturimi" prefWidth="100" text="%client.res.col.flight" />
                        <TableColumn fx:id="colRelacioni" prefWidth="180" text="%client.res.col.route" />
                        <TableColumn fx:id="colData" prefWidth="120" text="%client.res.col.date" />
                        <TableColumn fx:id="colKlasa" prefWidth="100" text="%client.res.col.class" />
                        <TableColumn fx:id="colCmimi" prefWidth="100" text="%client.res.col.price" />
                        <TableColumn fx:id="colStatusi" prefWidth="120" text="%client.res.col.status" />
                        <TableColumn fx:id="colVeprimet" prefWidth="140" text="%client.res.col.actions" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </VBox>
</HBox>
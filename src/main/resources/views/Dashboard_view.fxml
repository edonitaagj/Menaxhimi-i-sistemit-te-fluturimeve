<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="760" prefWidth="1200" style="-fx-background-color: #F1F5F9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController">

    <VBox prefWidth="220" style="-fx-background-color: linear-gradient(to bottom, #091E36, #030A12); -fx-padding: 0;">
        <VBox style="-fx-padding: 28 24 24 24; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="38" prefWidth="38" style="-fx-background-color: rgba(55,138,221,0.15); -fx-background-radius: 10; -fx-border-color: rgba(55,138,221,0.3); -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label style="-fx-text-fill: #3A94F2; -fx-font-size: 18;" text="A" />
                </StackPane>
                <VBox spacing="1">
                    <Label style="-fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: 900;" text="ADEM JASHARI" />
                    <Label style="-fx-text-fill: rgba(133,183,235,0.45); -fx-font-size: 10; -fx-font-weight: 600;" text="Dashboard" />
                </VBox>
            </HBox>
        </VBox>

        <VBox spacing="4" style="-fx-padding: 16 12 16 12;">
            <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-padding: 8 12 4 12;" text="NAVIGIMI" />

            <HBox fx:id="navDashboard" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(58,148,242,0.15); -fx-border-color: #3A94F2; -fx-border-width: 0 0 0 3; -fx-padding: 11 16 11 13; -fx-cursor: hand;">
                <Label style="-fx-font-size: 15;" text="📊" />
                <Label style="-fx-text-fill: #3A94F2; -fx-font-size: 13; -fx-font-weight: 700;" text="Dashboard" />
            </HBox>

            <HBox fx:id="navFluturimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="✈" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Fluturimet &amp; Oraret" />
            </HBox>

            <HBox fx:id="navRezervimet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="🎫" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Rezervimet &amp; Pagesat" />
            </HBox>

            <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 20 12 4 12;" text="LOGJISTIKA" />

            <HBox fx:id="navAvionet" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="🔧" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Avionët &amp; Mirëmbajtja" />
            </HBox>

            <HBox fx:id="navHumbur" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="🔍" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Artikujt e Humbur" />
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-size: 8; -fx-font-weight: 900; -fx-padding: 1 4 1 4; -fx-background-radius: 4;" text="NEW" />
            </HBox>

            <Label style="-fx-text-fill: rgba(255,255,255,0.25); -fx-font-size: 10; -fx-font-weight: 800; -fx-letter-spacing: 0.1em; -fx-padding: 20 12 4 12;" text="ADMINISTRIMI" />

            <HBox fx:id="navStafi" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="👥" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Menaxhimi i Stafit" />
            </HBox>

            <HBox fx:id="navPasagjeret" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="👤" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Pasagjerët" />
            </HBox>

            <HBox fx:id="navKompanite" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 11 16 11 16; -fx-cursor: hand; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.5);" text="🏢" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13; -fx-font-weight: 600;" text="Kompanitë &amp; Linjat" />
            </HBox>
        </VBox>

        <VBox style="-fx-padding: 16 16 24 16; -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1 0 0 0;">
            <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #F87171; -fx-font-size: 12; -fx-font-weight: 700; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: rgba(239,68,68,0.2); -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 8 0 8 0;" text="Dilni" />
        </VBox>
    </VBox>

    <VBox style="-fx-background-color: #F1F5F9;" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: white; -fx-padding: 18 28 18 28; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <VBox spacing="2">
                <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12; -fx-font-weight: 700;" text="Business Intelligence dhe AI" />
                <Label style="-fx-text-fill: #0F172A; -fx-font-size: 22; -fx-font-weight: 900;" text="Dashboard dhe Statistika" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleRefresh" style="-fx-background-color: #3A94F2; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 9; -fx-padding: 10 18 10 18; -fx-cursor: hand;" text="Rifresko" />
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background: #F1F5F9; -fx-background-color: #F1F5F9; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <VBox spacing="18" style="-fx-padding: 24 28 28 28;">

                <HBox spacing="14">
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Total fluturime" />
                        <Label fx:id="totalFluturimeLabel" style="-fx-text-fill: #0F172A; -fx-font-size: 28; -fx-font-weight: 900;" text="0" />
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Total rezervime" />
                        <Label fx:id="totalRezervimeLabel" style="-fx-text-fill: #0F172A; -fx-font-size: 28; -fx-font-weight: 900;" text="0" />
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Total bileta" />
                        <Label fx:id="totalBiletaLabel" style="-fx-text-fill: #0F172A; -fx-font-size: 28; -fx-font-weight: 900;" text="0" />
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Te hyra" />
                        <Label fx:id="totalTeHyraLabel" style="-fx-text-fill: #0F172A; -fx-font-size: 24; -fx-font-weight: 900;" text="0 EUR" />
                    </VBox>
                </HBox>

                <HBox spacing="14">
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Destinacioni me i kerkuar" />
                        <Label fx:id="topDestinacionLabel" style="-fx-text-fill: #0F172A; -fx-font-size: 26; -fx-font-weight: 900;" text="N/A" />
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12; -fx-font-weight: 700;" text="Mbushja mesatare" />
                        <Label fx:id="avgMbushjaLabel" style="-fx-text-fill: #0F172A; -fx-font-size: 26; -fx-font-weight: 900;" text="0%" />
                    </VBox>
                    <VBox prefWidth="440" style="-fx-background-color: #0F172A; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #1E293B; -fx-border-radius: 12; -fx-border-width: 1;">
                        <Label style="-fx-text-fill: #93C5FD; -fx-font-size: 12; -fx-font-weight: 900;" text="AI ANALYSIS" />
                        <TextArea fx:id="aiInsightText" editable="false" prefHeight="115" wrapText="true" style="-fx-background-color: transparent; -fx-control-inner-background: #0F172A; -fx-text-fill: white; -fx-font-size: 12; -fx-border-color: transparent;" />
                    </VBox>
                </HBox>

                <HBox spacing="16">
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #0F172A; -fx-font-size: 15; -fx-font-weight: 900;" text="Rezervime sipas muajve" />
                        <BarChart fx:id="rezervimeChart" animated="false" legendVisible="false" prefHeight="250">
                            <xAxis><CategoryAxis /></xAxis>
                            <yAxis><NumberAxis /></yAxis>
                        </BarChart>
                    </VBox>
                    <VBox prefWidth="360" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;">
                        <Label style="-fx-text-fill: #0F172A; -fx-font-size: 15; -fx-font-weight: 900;" text="Destinacionet kryesore" />
                        <PieChart fx:id="destinacionetChart" labelsVisible="true" legendVisible="true" prefHeight="250" />
                    </VBox>
                </HBox>

                <HBox spacing="16">
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #0F172A; -fx-font-size: 15; -fx-font-weight: 900;" text="Te hyrat sipas muajve" />
                        <LineChart fx:id="teHyratChart" animated="false" legendVisible="false" prefHeight="250">
                            <xAxis><CategoryAxis /></xAxis>
                            <yAxis><NumberAxis /></yAxis>
                        </LineChart>
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #0F172A; -fx-font-size: 15; -fx-font-weight: 900;" text="Statusi i fluturimeve" />
                        <BarChart fx:id="statusiChart" animated="false" legendVisible="false" prefHeight="250">
                            <xAxis><CategoryAxis /></xAxis>
                            <yAxis><NumberAxis /></yAxis>
                        </BarChart>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
